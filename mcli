#!/usr/bin/env bash
# mcli — manage custom services with Docker Compose
# https://github.com/milvasic/mcli

set -euo pipefail

VERSION="0.10.3"

# ── Help ──────────────────────────────────────────────────────────────────────
help() {
	colorize >&2 <<'EOF'
A single-file CLI for managing custom services with Docker Compose.

Usage: mcli <command> [service1 [service2 ...]] [--dry-run] [--all]

Commands:
  list                      # List discovered services (disabled services are marked)
  create-network            # Ensure the 'services' Docker bridge network exists
  start [services..]        # Start all or specified services (skips disabled)
  stop [services..]         # Stop all or specified services (skips disabled)
  restart [services..]      # Restart all or specified services (skips disabled)
  pull [services..]         # Pull latest images for all or specified services (skips disabled)
  backup <service>          # Stop service, back up to .bkp/<service>/<date>[.<counter>].tar.gz, restart service
                            #   Archive includes image.txt with container image digests
  backup <service> --live   # Back up without stopping (live backup)
  backup size               # Show disk space used by backups
  restore <service>         # Restore service from a backup archive in .bkp/<service>/
  disable <services..>      # Disable one or more services (excluded from start/stop/restart/pull)
  enable <services..>       # Re-enable one or more previously disabled services
  update                    # Update mcli to the latest version
  completions bash|zsh      # Output shell completion script (source to activate)
  version, --version, -v    # Print version
  help, --help, -h          # Show this message

Options:
  --dry-run                 # Print commands that would be executed, but do not run them
                            #   (applicable to: create-network, start, stop, restart, pull, backup, restore, update)
                            #   (can appear anywhere after the command)
  --all                     # Include disabled services in start/stop/restart/pull
                            #   (applicable to: start, stop, restart, pull)
                            #   (can appear anywhere after the command)
  --live                    # Skip stop/start around backup; back up while the service is running
                            #   (applicable to: backup)
                            #   (can appear anywhere after the command)

Service discovery:
  - Each service is an immediate subfolder containing a docker compose file (docker-compose.yml or docker-compose.yaml)
  - Folders in .gitignore (simple literal prefix matching only), folders with a .git directory, and symlinks are skipped

Configuration:
  Disabled services are stored in ${XDG_CONFIG_HOME:-~/.config}/mcli/disabled

Shell completions:
  # Bash (add to ~/.bashrc):
  source <(mcli completions bash)
  # Zsh (add to ~/.zshrc):
  source <(mcli completions zsh)

Usage example:
  mcli start                        # starts all enabled services by default
  mcli stop my-service --dry-run
  mcli disable my-service           # disables 'my-service' for future start/stop/pull commands
  mcli start --all                  # includes disabled services as well
EOF
	exit 1
}

# ── Colors & logging ──────────────────────────────────────────────────────────
if [ -t 1 ]; then
	RED=$'\033[0;31m'
	GREEN=$'\033[0;32m'
	YELLOW=$'\033[0;33m'
	CYAN=$'\033[0;36m'
	BOLD=$'\033[1m'
	RESET=$'\033[0m'
else
	RED=""
	GREEN=""
	YELLOW=""
	CYAN=""
	BOLD=""
	RESET=""
fi

log() { printf "\n${BOLD}=== %s ===${RESET}\n" "$1" >&2; }
dry_run_log() { printf "${YELLOW}[dry-run]${RESET} %s\n" "$1" >&2; }
error() { printf "${RED}ERROR:${RESET} %s\n" "$1" >&2; }
ok() { printf "${GREEN}%s${RESET}\n" "$1"; }

# ── Help colorizer ───────────────────────────────────────────────────────────
colorize_line() {
	sed \
		-e "s/\\(^\\|[^[:alnum:]_'-]\\)\\(mcli\\)\\([^[:alnum:]_'-]\\|$\\)/\\1${GREEN}\\2${RESET}\\3/g" \
		-e "s/\\(^\\|[^[:alnum:]_'-]\\)\\(list\\|create-network\\|start\\|stop\\|restart\\|pull\\|backup\\|restore\\|enable\\|disable\\|update\\|completions\\|version\\|help\\)\\([^[:alnum:]_'-]\\|$\\)/\\1${YELLOW}\\2${RESET}\\3/g" \
		-e "s/--[a-z][a-z-]*/${CYAN}&${RESET}/g" \
		-e "s/\([ ,]\)\(-[a-z]\)/\\1${CYAN}\\2${RESET}/g"
}

colorize() {
	local line pre post
	while IFS= read -r line; do
		if [[ "$line" == *'#'* ]]; then
			pre="${line%%#*}"
			post="${line#*#}"
			pre="$(printf '%s' "$pre" | colorize_line)"
			printf '%s%s#%s%s\n' "$pre" "$GREEN" "$post" "$RESET"
		else
			printf '%s\n' "$line" | colorize_line
		fi
	done
}

# ── Configuration ─────────────────────────────────────────────────────────────
config_file() {
	echo "${XDG_CONFIG_HOME:-$HOME/.config}/mcli/disabled"
}

get_disabled_services() {
	local cf
	cf=$(config_file)
	[ -f "$cf" ] || return 0
	local prefix
	prefix="$(pwd)/"
	while IFS= read -r line; do
		[[ -z "$line" ]] && continue
		if [[ "$line" == "$prefix"* ]]; then
			echo "${line#"$prefix"}"
		fi
	done <"$cf"
}

is_service_disabled() {
	local service="$1"
	local cf
	cf=$(config_file)
	[ -f "$cf" ] || return 1
	grep -qxF "$(pwd)/$service" "$cf"
}

# ── Service discovery ─────────────────────────────────────────────────────────
get_services() {
	local services=()
	local gitignore=()
	if [ -f .gitignore ]; then
		mapfile -t gitignore < <(grep -v '^#' .gitignore | grep -v '^$' || true)
	fi
	shopt -s nullglob
	for dir in */; do
		# skip if not a directory
		[ -d "$dir" ] || continue
		# skip symlinks
		[ -L "$dir" ] && continue
		# skip .gitignore entries (simple literal prefix matching only; full gitignore glob syntax is not supported)
		for ignore in "${gitignore[@]}"; do
			[[ "$dir" == "$ignore"* ]] && continue 2
		done
		# skip if .git exists in the folder
		[ -d "$dir/.git" ] && continue
		# must have docker-compose.yml or docker-compose.yaml
		if [ -f "$dir/docker-compose.yml" ] || [ -f "$dir/docker-compose.yaml" ]; then
			services+=("${dir%/}")
		fi
	done
	shopt -u nullglob
	[[ ${#services[@]} -gt 0 ]] && printf '%s\n' "${services[@]}"
}

# Filter services by arguments (if any), excluding disabled services unless --all
filter_services() {
	local all_services=()
	mapfile -t all_services < <(get_services)
	local disabled_services=()
	mapfile -t disabled_services < <(get_disabled_services)

	local candidates=()
	if [ $# -eq 0 ]; then
		candidates=("${all_services[@]}")
	else
		local invalid=false
		for arg in "$@"; do
			local matched=false
			for svc in "${all_services[@]}"; do
				if [[ "$svc" == "$arg" ]]; then
					candidates+=("$svc")
					matched=true
				fi
			done
			if ! $matched; then
				error "Unknown service: ${CYAN}${arg}${RESET}"
				invalid=true
			fi
		done
		$invalid && return 1
	fi

	# Remove disabled services unless --all is set
	if $include_all || [ ${#disabled_services[@]} -eq 0 ]; then
		printf '%s\n' "${candidates[@]}"
	else
		for svc in "${candidates[@]}"; do
			local is_disabled=false
			for dsvc in "${disabled_services[@]}"; do
				if [[ "$svc" == "$dsvc" ]]; then
					is_disabled=true
					break
				fi
			done
			if $is_disabled; then
				if [ $# -gt 0 ]; then
					error "'${CYAN}${svc}${RESET}' is disabled (use ${CYAN}--all${RESET} to include it)"
				fi
			else
				echo "$svc"
			fi
		done
	fi
}

# ── List command ──────────────────────────────────────────────────────────────
list() {
	log "Discovered services:"
	local services=()
	mapfile -t services < <(get_services)
	if [[ ${#services[@]} -eq 0 ]]; then
		echo "  (none found)"
	else
		local enabled=() disabled=()
		for service in "${services[@]}"; do
			if is_service_disabled "$service"; then
				disabled+=("$service")
			else
				enabled+=("$service")
			fi
		done
		IFS=$'\n' read -r -d '' -a enabled < <(printf '%s\n' "${enabled[@]}" | sort && printf '\0') || true
		IFS=$'\n' read -r -d '' -a disabled < <(printf '%s\n' "${disabled[@]}" | sort && printf '\0') || true
		for service in "${enabled[@]}"; do
			printf "  ${CYAN}%s${RESET}\n" "$service"
		done
		for service in "${disabled[@]}"; do
			printf "  ${CYAN}%s${RESET} ${YELLOW}(disabled)${RESET}\n" "$service"
		done
	fi
}

# ── Core commands ───────────────────────────────────────────────────────────────────
create_network() {
	log "Ensuring Docker network 'services' exists"
	if $dry_run; then
		dry_run_log "docker network inspect services || docker network create --driver bridge services"
	elif docker network inspect services >/dev/null 2>&1; then
		log "Network 'services' already exists"
	else
		docker network create --driver bridge services
	fi
}

start() {
	local services=()
	local services_output
	services_output=$(filter_services "$@") || return 1
	[[ -n "$services_output" ]] && mapfile -t services <<<"$services_output"
	local failed=()
	for service in "${services[@]}"; do
		log "Starting ${CYAN}${service}${RESET}"
		local cmd
		cmd="docker compose --project-directory \"$service\" up -d"
		if $dry_run; then
			dry_run_log "$cmd"
		else
			if ! eval "$cmd"; then
				error "${CYAN}${service}${RESET} start failed"
				failed+=("$service")
			fi
		fi
	done
	if [ ${#failed[@]} -gt 0 ]; then
		error "The following services failed to start: ${CYAN}${failed[*]}${RESET}"
		return 1
	fi
}

stop() {
	local services=()
	local services_output
	services_output=$(filter_services "$@") || return 1
	[[ -n "$services_output" ]] && mapfile -t services <<<"$services_output"
	local failed=()
	for service in "${services[@]}"; do
		log "Stopping ${CYAN}${service}${RESET}"
		local cmd
		cmd="docker compose --project-directory \"$service\" down --remove-orphans"
		if $dry_run; then
			dry_run_log "$cmd"
		else
			if ! eval "$cmd"; then
				error "${CYAN}${service}${RESET} stop failed"
				failed+=("$service")
			fi
		fi
	done
	if [ ${#failed[@]} -gt 0 ]; then
		error "The following services failed to stop: ${CYAN}${failed[*]}${RESET}"
		return 1
	fi
}

restart() {
	stop "$@" || return 1
	start "$@"
}

# ── Disable / Enable commands ──────────────────────────────────────────────────────
enable() {
	if [ $# -eq 0 ]; then
		error "Usage: mcli enable <service1> [service2 ...]"
		return 1
	fi
	local all_services=()
	mapfile -t all_services < <(get_services)
	local invalid=false
	for arg in "$@"; do
		local matched=false
		for svc in "${all_services[@]}"; do
			[[ "$svc" == "$arg" ]] && matched=true && break
		done
		if ! $matched; then
			error "Unknown service: ${CYAN}${arg}${RESET}"
			invalid=true
		fi
	done
	$invalid && return 1

	local cf
	cf=$(config_file)
	for arg in "$@"; do
		local entry
		entry="$(pwd)/$arg"
		if [ -f "$cf" ] && grep -qxF "$entry" "$cf"; then
			local tmp
			tmp=$(grep -vxF "$entry" "$cf" || true)
			printf '%s\n' "$tmp" >"$cf"
			# Remove trailing empty lines left by printf on empty content
			if [ ! -s "$cf" ] || [ -z "$(tr -d '[:space:]' <"$cf")" ]; then
				>"$cf"
			fi
			ok "${CYAN}${arg}${RESET} enabled"
		else
			ok "${CYAN}${arg}${RESET} is already enabled"
		fi
	done
}

disable() {
	if [ $# -eq 0 ]; then
		error "Usage: mcli disable <service1> [service2 ...]"
		return 1
	fi
	local all_services=()
	mapfile -t all_services < <(get_services)
	local invalid=false
	for arg in "$@"; do
		local matched=false
		for svc in "${all_services[@]}"; do
			[[ "$svc" == "$arg" ]] && matched=true && break
		done
		if ! $matched; then
			error "Unknown service: ${CYAN}${arg}${RESET}"
			invalid=true
		fi
	done
	$invalid && return 1

	local cf
	cf=$(config_file)
	mkdir -p "$(dirname "$cf")"
	touch "$cf"
	for arg in "$@"; do
		local entry
		entry="$(pwd)/$arg"
		if grep -qxF "$entry" "$cf"; then
			ok "${CYAN}${arg}${RESET} is already disabled"
		else
			echo "$entry" >>"$cf"
			ok "${CYAN}${arg}${RESET} disabled"
		fi
	done
}

pull() {
	local services=()
	local services_output
	services_output=$(filter_services "$@") || return 1
	[[ -n "$services_output" ]] && mapfile -t services <<<"$services_output"
	local failed=()
	for service in "${services[@]}"; do
		log "Pulling images for ${CYAN}${service}${RESET} (skipping buildable services)"
		local cmd
		cmd="docker compose --project-directory \"$service\" pull --ignore-buildable"
		if $dry_run; then
			dry_run_log "$cmd"
		else
			if ! eval "$cmd"; then
				error "${CYAN}${service}${RESET} pull failed"
				failed+=("$service")
			fi
		fi
	done
	if [ ${#failed[@]} -gt 0 ]; then
		error "The following services failed to pull: ${CYAN}${failed[*]}${RESET}"
		return 1
	fi
}

# Returns 0 if name matches a registered service directory, 1 otherwise.
# Distinct from filter_services: does not exclude disabled services.
is_known_service() {
	local name="$1" svc
	while IFS= read -r svc; do
		[[ "$svc" == "$name" ]] && return 0
	done < <(get_services)
	return 1
}

# ── Image capture ────────────────────────────────────────────────────────────
# Writes <image-name>:<tag>@sha256:<digest> lines for each container.
# Falls back to compose file image references if no containers are running.
capture_image_info() {
	local service="$1"
	local lines=()

	local container_ids
	container_ids=$(docker compose --project-directory "$service" ps -q 2>/dev/null) || true

	if [[ -n "$container_ids" ]]; then
		while IFS= read -r cid; do
			[[ -z "$cid" ]] && continue
			local img_ref img_id repo_digest digest
			img_ref=$(docker inspect --format '{{.Config.Image}}' "$cid" 2>/dev/null) || continue
			img_id=$(docker inspect --format '{{.Image}}' "$cid" 2>/dev/null) || continue
			repo_digest=$(docker image inspect --format '{{index .RepoDigests 0}}' "$img_id" 2>/dev/null) || true
			if [[ -n "$repo_digest" ]]; then
				digest="${repo_digest#*@}"
			else
				digest="$img_id"
			fi
			lines+=("${img_ref}@${digest}")
		done <<< "$container_ids"
	fi

	if [[ ${#lines[@]} -eq 0 ]]; then
		local images
		images=$(docker compose --project-directory "$service" config --images 2>/dev/null) || true
		if [[ -n "$images" ]]; then
			while IFS= read -r img; do
				[[ -z "$img" ]] && continue
				lines+=("$img")
			done <<< "$images"
		fi
	fi

	[[ ${#lines[@]} -gt 0 ]] && printf '%s\n' "${lines[@]}"
}

# ── Backup command ────────────────────────────────────────────────────────────
backup_size() {
	local bkp_root=".bkp"
	if [ ! -d "$bkp_root" ]; then
		ok "No backups found (.bkp does not exist)"
		return 0
	fi
	log "Backup disk usage"
	local found=false
	local max_width=5  # at least len("total")
	local -a names sizes
	local err_file
	err_file=$(mktemp)
	shopt -s nullglob
	for svc_dir in "$bkp_root"/*/; do
		found=true
		local size name
		size=$(du -sh "$svc_dir" 2>>"$err_file" | cut -f1) || true
		name="${svc_dir#"$bkp_root"/}"
		name="${name%/}"
		names+=("$name")
		sizes+=("$size")
		if (( ${#name} > max_width )); then max_width=${#name}; fi
	done
	shopt -u nullglob
	if ! $found; then
		rm -f "$err_file"
		ok "No backups found"
		return 0
	fi
	local i
	for i in "${!names[@]}"; do
		printf "  ${CYAN}%-*s${RESET}  %s\n" "$max_width" "${names[$i]}" "${sizes[$i]}"
	done
	local total
	total=$(du -sh "$bkp_root" 2>>"$err_file" | cut -f1) || true
	printf "  %s\n" "$(printf '%*s' "$((max_width + 2))" '' | tr ' ' '-')"
	printf "  ${BOLD}%-*s${RESET}  %s\n" "$max_width" "total" "$total"
	if [[ -s "$err_file" ]]; then
		printf "${YELLOW}note:${RESET} some sizes may be under-counted due to permission errors; run with sudo for full coverage\n" >&2
	fi
	rm -f "$err_file"
}

backup() {
	if [ $# -eq 1 ] && [ "$1" = "size" ] && ! is_known_service "size"; then
		backup_size
		return 0
	fi
	if [ $# -ne 1 ]; then
		error "Usage: mcli backup <service> [--live]"
		return 1
	fi
	local service="$1"

	if ! is_known_service "$service"; then
		error "Unknown service: ${CYAN}${service}${RESET}"
		return 1
	fi

	local today
	today=$(date +%Y-%m-%d)
	local bkp_dir=".bkp/${service}"
	local base="${bkp_dir}/${today}"
	local dest="${base}.tar.gz"

	# Capture image info before stopping (non-live) or from running containers (live)
	log "Capturing image info for ${CYAN}${service}${RESET}"
	local image_lines=()
	if $dry_run; then
		dry_run_log "docker compose --project-directory \"$service\" ps -q → per-container docker inspect (Config.Image + RepoDigest) → image.txt"
	else
		mapfile -t image_lines < <(capture_image_info "$service")
		if [[ ${#image_lines[@]} -eq 0 ]]; then
			printf "${YELLOW}Warning:${RESET} no image info captured for ${CYAN}${service}${RESET} (image.txt will be empty)\n" >&2
		fi
	fi

	# Stop service before backup unless --live is set
	if ! $live; then
		log "Stopping ${CYAN}${service}${RESET} before backup"
		local stop_cmd
		stop_cmd="docker compose --project-directory \"$service\" down --remove-orphans"
		if $dry_run; then
			dry_run_log "$stop_cmd"
		else
			if ! eval "$stop_cmd"; then
				error "Failed to stop ${CYAN}${service}${RESET} before backup"
				return 1
			fi
		fi
	fi

	local max_attempts=100
	if $dry_run; then
		if [ -f "$dest" ]; then
			local counter=1
			while [ -f "${base}.${counter}.tar.gz" ]; do
				((counter++))
				if [ "$counter" -ge "$max_attempts" ]; then
					error "Could not claim a backup slot after ${max_attempts} attempts"
					return 1
				fi
			done
			dest="${base}.${counter}.tar.gz"
		fi
		log "Backing up ${CYAN}${service}${RESET} to ${dest}"
		dry_run_log "mkdir -p \"${bkp_dir}\" && sudo tar czf \"${dest}\" -C \"${service}\" . -C \"\$(mktemp -d)\" image.txt"
	else
		mkdir -p "$bkp_dir"
		# Install the cleanup trap before claiming the slot so a Ctrl-C between
		# the noclobber claim and the trap install can't orphan a placeholder.
		# Guarded by $claimed/$tmp_dir so the trap is a no-op until each resource
		# actually exists.
		local claimed=""
		local tmp_dir=""
		trap '[[ -n "$claimed" ]] && rm -f "$claimed"; [[ -n "$tmp_dir" ]] && rm -rf "$tmp_dir"' INT TERM EXIT
		# Atomically claim the destination using noclobber; retry with incrementing counter on collision
		local counter=1
		if ! ( set -C; : > "$dest" ) 2>/dev/null; then
			while ! ( set -C; : > "${base}.${counter}.tar.gz" ) 2>/dev/null; do
				((counter++))
				if [ "$counter" -ge "$max_attempts" ]; then
					trap - INT TERM EXIT
					error "Could not claim a backup slot after ${max_attempts} attempts"
					if ! $live; then
						log "Restarting ${CYAN}${service}${RESET} after failed backup"
						docker compose --project-directory "$service" up -d || true
					fi
					return 1
				fi
			done
			dest="${base}.${counter}.tar.gz"
		fi
		claimed="$dest"
		log "Backing up ${CYAN}${service}${RESET} to ${dest}"
		tmp_dir=$(mktemp -d)
		if [[ ${#image_lines[@]} -gt 0 ]]; then
			printf '%s\n' "${image_lines[@]}" > "$tmp_dir/image.txt"
		else
			> "$tmp_dir/image.txt"
		fi
		if ! sudo tar czf "${dest}" -C "${service}" . -C "$tmp_dir" image.txt; then
			trap - INT TERM EXIT
			error "Backup of ${CYAN}${service}${RESET} failed"
			rm -f "$dest"
			rm -rf "$tmp_dir"
			if ! $live; then
				log "Restarting ${CYAN}${service}${RESET} after failed backup"
				docker compose --project-directory "$service" up -d || true
			fi
			return 1
		fi
		rm -rf "$tmp_dir"
		tmp_dir=""
		claimed=""
		trap - INT TERM EXIT
		ok "Backup created: ${dest}"
	fi

	# Restart service after backup unless --live is set
	if ! $live; then
		log "Restarting ${CYAN}${service}${RESET} after backup"
		local start_cmd
		start_cmd="docker compose --project-directory \"$service\" up -d"
		if $dry_run; then
			dry_run_log "$start_cmd"
		else
			if ! eval "$start_cmd"; then
				error "Failed to restart ${CYAN}${service}${RESET} after backup"
				return 1
			fi
		fi
	fi
}

# ── Restore command ───────────────────────────────────────────────────────────
restore() {
	if [ $# -ne 1 ]; then
		error "Usage: mcli restore <service>"
		return 1
	fi
	local service="$1"

	if ! is_known_service "$service"; then
		error "Unknown service: ${CYAN}${service}${RESET}"
		return 1
	fi

	local bkp_dir=".bkp/${service}"

	# Collect available backups: regular first, then pre-restore (tagged), so the
	# picker visually separates the two and never renders identically-named
	# archives on the same line.
	local backups=()
	local labels=()
	shopt -s nullglob
	for f in "${bkp_dir}"/*.tar.gz; do
		backups+=("$f")
		labels+=("$(basename "$f")")
	done
	for f in "${bkp_dir}"/pre-restore/*.tar.gz; do
		backups+=("$f")
		labels+=("[pre-restore] $(basename "$f")")
	done
	shopt -u nullglob

	if [ ${#backups[@]} -eq 0 ]; then
		error "No backups found for ${CYAN}${service}${RESET} in ${bkp_dir}/"
		return 1
	fi

	local chosen
	local chosen_label
	if [ ${#backups[@]} -eq 1 ]; then
		chosen="${backups[0]}"
		chosen_label="${labels[0]}"
		log "Restoring ${CYAN}${service}${RESET} from ${chosen_label}"
	elif $dry_run; then
		log "Available backups for ${CYAN}${service}${RESET}:"
		local i=1
		for label in "${labels[@]}"; do
			printf "  %d) %s\n" "$i" "$label" >&2
			((i++))
		done
		dry_run_log "Would prompt: Select backup [1-${#backups[@]}]"
		chosen="${backups[0]}"
		chosen_label="${labels[0]}"
		log "Restoring ${CYAN}${service}${RESET} from ${chosen_label} (dry-run: using first)"
	else
		log "Available backups for ${CYAN}${service}${RESET}:"
		local i=1
		for label in "${labels[@]}"; do
			printf "  %d) %s\n" "$i" "$label" >&2
			((i++))
		done
		local choice
		while true; do
			printf "Select backup [1-%d]: " "${#backups[@]}" >&2
			read -r choice
			if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#backups[@]}" ]; then
				break
			fi
			error "Invalid selection. Enter a number between 1 and ${#backups[@]}."
		done
		chosen="${backups[$((choice - 1))]}"
		chosen_label="${labels[$((choice - 1))]}"
		log "Restoring ${CYAN}${service}${RESET} from ${chosen_label}"
	fi

	# Stop service first (ensures a clean snapshot if user requests pre-restore backup)
	log "Stopping ${CYAN}${service}${RESET} before restore"
	local stop_cmd
	stop_cmd="docker compose --project-directory \"$service\" down --remove-orphans"
	if $dry_run; then
		dry_run_log "$stop_cmd"
	else
		if ! eval "$stop_cmd"; then
			error "Failed to stop ${CYAN}${service}${RESET} before restore"
			return 1
		fi
	fi

	# Pre-restore backup prompt (after stop, so the archive captures a clean state)
	if $dry_run; then
		dry_run_log "Prompt: 'Back up current version before restoring? [y/N]'"
		dry_run_log "sudo tar czf \"${bkp_dir}/pre-restore/<date>.tar.gz\" -C \"${service}\" ."
	else
		local pre_restore_ans
		printf "Back up current version before restoring? [y/N] " >&2
		read -r pre_restore_ans
		if [[ "$pre_restore_ans" =~ ^[Yy]$ ]]; then
			local today pre_restore_dir pre_restore_dest
			today=$(date +%Y-%m-%d)
			pre_restore_dir="${bkp_dir}/pre-restore"
			pre_restore_dest="${pre_restore_dir}/${today}.tar.gz"
			mkdir -p "$pre_restore_dir"
			if [ -f "$pre_restore_dest" ]; then
				local counter=1
				while [ -f "${pre_restore_dir}/${today}.${counter}.tar.gz" ]; do
					((counter++))
				done
				pre_restore_dest="${pre_restore_dir}/${today}.${counter}.tar.gz"
			fi
			log "Creating pre-restore backup of ${CYAN}${service}${RESET}"
			if ! sudo tar czf "$pre_restore_dest" -C "$service" .; then
				error "Failed to create pre-restore backup"
				return 1
			fi
			ok "Pre-restore backup: ${pre_restore_dest}"
		fi
	fi

	# Clean service dir so restore matches the archive exactly (files added after
	# the backup would otherwise survive, since tar only overwrites overlapping
	# paths). Note: this also wipes bind-mounted paths nested under $service.
	log "Cleaning ${service}/ before extraction"
	local clean_cmd
	clean_cmd="sudo find \"${service}\" -mindepth 1 -delete"
	if $dry_run; then
		dry_run_log "$clean_cmd"
	else
		if ! eval "$clean_cmd"; then
			error "Failed to clean ${CYAN}${service}${RESET} before restore"
			log "Attempting to restart ${CYAN}${service}${RESET} after failed cleanup"
			docker compose --project-directory "$service" up -d || true
			return 1
		fi
	fi

	# Extract archive into service directory
	log "Extracting $(basename "$chosen") into ${service}/"
	local restore_cmd
	restore_cmd="sudo tar xzf \"${chosen}\" -C \"${service}\""
	if $dry_run; then
		dry_run_log "$restore_cmd"
	else
		if ! eval "$restore_cmd"; then
			error "Restore of ${CYAN}${service}${RESET} failed"
			log "Attempting to restart ${CYAN}${service}${RESET} after failed restore"
			docker compose --project-directory "$service" up -d || true
			return 1
		fi
		ok "Restored: $(basename "$chosen") → ${service}/"
	fi

	# Start service
	log "Starting ${CYAN}${service}${RESET} after restore"
	local start_cmd
	start_cmd="docker compose --project-directory \"$service\" up -d"
	if $dry_run; then
		dry_run_log "$start_cmd"
	else
		if ! eval "$start_cmd"; then
			error "Failed to start ${CYAN}${service}${RESET} after restore"
			return 1
		fi
	fi
}

# ── Completions command ───────────────────────────────────────────────────────
completions() {
	local shell="${1:-}"
	case "$shell" in
	bash)
		cat <<'BASH_COMPLETION'
# mcli bash completion
# Source this file or add to ~/.bashrc: source <(mcli completions bash)

__mcli_services() {
	mcli list 2>/dev/null \
		| sed 's/\x1b\[[0-9;]*m//g; s/^ *//; s/ (disabled)//' \
		| grep -v '^(none found)$' | grep -v '^$'
}

_mcli() {
	COMPREPLY=()
	local cur="${COMP_WORDS[COMP_CWORD]}"
	local cword="$COMP_CWORD"
	local command="${COMP_WORDS[1]:-}"
	local all_commands="list create-network start stop restart pull backup restore disable enable update completions version help"

	if [[ "$cword" -eq 1 ]]; then
		COMPREPLY=($(compgen -W "$all_commands" -- "$cur"))
		return
	fi

	case "$command" in
	start | stop | restart | pull)
		COMPREPLY=($(compgen -W "$(__mcli_services) --dry-run --all" -- "$cur"))
		;;
	disable | enable | restore)
		COMPREPLY=($(compgen -W "$(__mcli_services) --dry-run" -- "$cur"))
		;;
	backup)
		COMPREPLY=($(compgen -W "size $(__mcli_services) --dry-run --live" -- "$cur"))
		;;
	completions)
		COMPREPLY=($(compgen -W "bash zsh" -- "$cur"))
		;;
	create-network | update)
		COMPREPLY=($(compgen -W "--dry-run" -- "$cur"))
		;;
	esac
}

complete -F _mcli mcli
BASH_COMPLETION
		;;
	zsh)
		cat <<'ZSH_COMPLETION'
#compdef mcli
# mcli zsh completion
# Source this file or add to ~/.zshrc: source <(mcli completions zsh)

_mcli() {
	local cur="${words[CURRENT]}"
	local cmd="${words[2]:-}"
	local -a services

	if [[ $CURRENT -eq 2 ]]; then
		local -a commands
		commands=(
			'list:List discovered services'
			'create-network:Ensure the shared services Docker bridge network exists'
			'start:Start all or specified services'
			'stop:Stop all or specified services'
			'restart:Restart all or specified services'
			'pull:Pull latest images for services'
			'backup:Back up a service'
			'restore:Restore a service from a backup archive'
			'disable:Disable one or more services'
			'enable:Re-enable one or more services'
			'update:Update mcli to the latest version'
			'completions:Output shell completions script'
			'version:Print version'
			'help:Show help message'
		)
		_describe 'command' commands
		return
	fi

	services=(${(f)"$(mcli list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g; s/^ *//; s/ (disabled)//' | grep -v '^(none found)$' | grep -v '^$')"})

	case "$cmd" in
	start | stop | restart | pull)
		compadd -a services
		compadd -- --dry-run --all
		;;
	disable | enable | restore)
		compadd -a services
		compadd -- --dry-run
		;;
	backup)
		compadd -- size
		compadd -a services
		compadd -- --dry-run --live
		;;
	completions)
		compadd -- bash zsh
		;;
	create-network | update)
		compadd -- --dry-run
		;;
	esac
}

_mcli "$@"
ZSH_COMPLETION
		;;
	*)
		error "Usage: mcli completions <shell>"
		printf "Supported shells: bash, zsh\n" >&2
		exit 1
		;;
	esac
}

# ── Update command ────────────────────────────────────────────────────────────
INSTALLER_SELF_URL="https://raw.githubusercontent.com/milvasic/mcli/refs/heads/main/install.sh"
update() {
	if $dry_run; then
		dry_run_log "bash -c \"\$(curl -fsSL \"${INSTALLER_SELF_URL}\")\""
		return
	fi
	if command -v curl >/dev/null 2>&1; then
		bash -c "$(curl -fsSL "${INSTALLER_SELF_URL}")" -- --yes
	elif command -v wget >/dev/null 2>&1; then
		bash -c "$(wget -qO- "${INSTALLER_SELF_URL}")" -- --yes
	else
		error "Neither curl nor wget found. Please install one and try again."
		exit 1
	fi
}

# ── Main dispatch ─────────────────────────────────────────────────────────────────
COMMAND="${1:-}"
[ $# -ge 1 ] && shift

# parse options, collect service names after options
service_args=()
dry_run=false
include_all=false
live=false
while [[ $# -gt 0 ]]; do
	case "$1" in
	--dry-run)
		dry_run=true
		shift
		;;
	--all)
		include_all=true
		shift
		;;
	--live)
		live=true
		shift
		;;
	-*)
		error "Unknown option: $1"
		exit 1
		;;
	*)
		service_args+=("$1")
		shift
		;;
	esac
done

case "${COMMAND}" in
list) list ;;
create-network) create_network ;;
start) start "${service_args[@]}" ;;
stop) stop "${service_args[@]}" ;;
restart) restart "${service_args[@]}" ;;
pull) pull "${service_args[@]}" ;;
backup) backup "${service_args[@]}" ;;
restore) restore "${service_args[@]}" ;;
enable) enable "${service_args[@]}" ;;
disable) disable "${service_args[@]}" ;;
update) update ;;
completions) completions "${service_args[@]}" ;;
version | --version | -v) echo "$VERSION" ;;
help | --help | -h) help ;;
*)
	error "Unknown command: ${COMMAND}"
	help
	;;
esac
