# Compare two semver strings (X.Y.Z). Prints: greater | lesser | equal.
semver_cmp() {
	local v1="$1" v2="$2"
	if [ "$v1" = "$v2" ]; then echo "equal"; return; fi
	local i n1 n2
	for i in 1 2 3; do
		n1="$(echo "$v1" | cut -d. -f"$i")"
		n2="$(echo "$v2" | cut -d. -f"$i")"
		n1="${n1:-0}"; n2="${n2:-0}"
		if [ "$n1" -gt "$n2" ]; then echo "greater"; return
		elif [ "$n1" -lt "$n2" ]; then echo "lesser"; return
		fi
	done
	echo "equal"
}

update() {
	if $check_only; then
		local tmpfile
		tmpfile="$(mktemp)"
		trap 'rm -f "$tmpfile"' INT TERM EXIT
		local fetch_ok=true
		if command -v curl >/dev/null 2>&1; then
			curl -fsSL "$MCLI_SELF_URL" -o "$tmpfile" 2>/dev/null || fetch_ok=false
		elif command -v wget >/dev/null 2>&1; then
			wget -qO "$tmpfile" "$MCLI_SELF_URL" 2>/dev/null || fetch_ok=false
		else
			error "Neither curl nor wget found. Please install one and try again."
			exit 3
		fi
		if ! $fetch_ok; then
			error "Failed to fetch remote version."
			exit 3
		fi
		local remote_version
		remote_version="$(grep -m1 '^VERSION=' "$tmpfile" | sed 's/^VERSION="//;s/"$//')"
		if [ -z "$remote_version" ]; then
			error "Could not determine remote version."
			exit 3
		fi
		local cmp
		cmp="$(semver_cmp "$remote_version" "$VERSION")"
		case "$cmp" in
		equal)
			ok "up to date"
			exit 0
			;;
		greater)
			ok "update available: $VERSION → $remote_version"
			exit 1
			;;
		lesser)
			ok "local version is newer"
			exit 2
			;;
		esac
	fi
	if $dry_run; then
		dry_run_log "bash -c \"\$(curl -fsSL \"${INSTALLER_SELF_URL}\")\""
		return
	fi
	if command -v curl >/dev/null 2>&1; then
		bash -c "$(curl -fsSL "${INSTALLER_SELF_URL}")" -- --yes
	elif command -v wget >/dev/null 2>&1; then
		bash -c "$(wget -qO- "${INSTALLER_SELF_URL}")" -- --yes
	else
		error "Neither curl nor wget found. Please install one and try again."
		exit 1
	fi
}

# ── Main dispatch ─────────────────────────────────────────────────────────────────
COMMAND="${1:-}"
[ $# -ge 1 ] && shift

# parse options, collect service names after options
service_args=()
dry_run=false
include_all=false
live=false
keep_count=""
older_than=""
prune_service=""
check_only=false
output_json=false
output_plain=false
follow=false
tail_count=""
no_health=false
health_timeout=15
health_timeout_set=false
backup_name=""
auto_yes=false
no_pre_restore=false
unified=false
images_only=false
use_sudo="auto"
_sudo_flag=false
_no_sudo_flag=false
while [[ $# -gt 0 ]]; do
	case "$1" in
	--dry-run)
		dry_run=true
		shift
		;;
	--all)
		include_all=true
		shift
		;;
	--live)
		live=true
		shift
		;;
	--keep)
		if [ $# -lt 2 ]; then
			error "Option --keep requires a positive integer argument"
			exit 1
		fi
		if [[ ! "$2" =~ ^[1-9][0-9]*$ ]]; then
			error "Option --keep requires a positive integer (got: $2)"
			exit 1
		fi
		keep_count="$2"
		shift 2
		;;
	--older-than)
		if [ $# -lt 2 ]; then
			error "Option --older-than requires a duration argument (e.g. 30d)"
			exit 1
		fi
		older_than="$2"
		shift 2
		;;
	--service)
		if [ $# -lt 2 ]; then
			error "Option --service requires a service name"
			exit 1
		fi
		prune_service="$2"
		shift 2
		;;
	--json)
		output_json=true
		shift
		;;
	--plain)
		output_plain=true
		shift
		;;
	--follow | -f)
		follow=true
		shift
		;;
	--tail)
		if [ $# -lt 2 ]; then
			error "Option --tail requires a positive integer argument"
			exit 1
		fi
		if [[ ! "$2" =~ ^[1-9][0-9]*$ ]]; then
			error "Option --tail requires a positive integer (got: $2)"
			exit 1
		fi
		tail_count="$2"
		shift 2
		;;
	--check)
		check_only=true
		shift
		;;
	--no-health)
		no_health=true
		shift
		;;
	--health-timeout)
		if [ $# -lt 2 ]; then
			error "Option --health-timeout requires a positive integer argument"
			exit 1
		fi
		if [[ ! "$2" =~ ^[1-9][0-9]*$ ]]; then
			error "Option --health-timeout requires a positive integer (got: $2)"
			exit 1
		fi
		health_timeout="$2"
		health_timeout_set=true
		shift 2
		;;
	--backup)
		if [ $# -lt 2 ]; then
			error "Option --backup requires an argument (filename, 'latest', or 'pre-restore-latest')"
			exit 1
		fi
		backup_name="$2"
		shift 2
		;;
	--yes)
		auto_yes=true
		shift
		;;
	--no-pre-restore)
		no_pre_restore=true
		shift
		;;
	--unified)
		unified=true
		shift
		;;
	--images-only)
		images_only=true
		shift
		;;
	--sudo)
		use_sudo="true"; _sudo_flag=true
		shift
		;;
	--no-sudo)
		use_sudo="false"; _no_sudo_flag=true
		shift
		;;
	-*)
		error "Unknown option: $1"
		exit 1
		;;
	*)
		service_args+=("$1")
		shift
		;;
	esac
done

if [[ "${COMMAND}" != "backup" && ( -n "$older_than" || -n "$prune_service" ) ]]; then
	error "--older-than and --service are only valid for 'backup prune'"
	exit 1
fi

if [[ -n "$backup_name" ]] && [[ "${COMMAND}" != "restore" && "${COMMAND}" != "diff" ]]; then
	error "--backup is only valid for 'restore' and 'diff'"
	exit 1
fi

if [[ $auto_yes == true || $no_pre_restore == true ]] && [[ "${COMMAND}" != "restore" ]]; then
	error "--yes and --no-pre-restore are only valid for 'restore'"
	exit 1
fi

if $auto_yes && $no_pre_restore; then
	error "--yes and --no-pre-restore are mutually exclusive"
	exit 1
fi

if [[ "$use_sudo" != "auto" ]] && [[ "${COMMAND}" != "backup" && "${COMMAND}" != "restore" && "${COMMAND}" != "diff" ]]; then
	error "--sudo and --no-sudo are only valid for 'backup', 'restore', and 'diff'"
	exit 1
fi

if $_sudo_flag && $_no_sudo_flag; then
	error "--sudo and --no-sudo are mutually exclusive"
	exit 1
fi

if $check_only && [[ "${COMMAND}" != "update" ]]; then
	error "--check is only valid for 'update'"
	exit 1
fi

if ($no_health || $health_timeout_set) && [[ "${COMMAND}" != "start" && "${COMMAND}" != "restart" ]]; then
	error "--no-health and --health-timeout are only valid for 'start' and 'restart'"
	exit 1
fi

if $no_health && $health_timeout_set; then
	printf "${YELLOW}warning:${RESET} --health-timeout has no effect when --no-health is set\n" >&2
fi

if $output_json && $output_plain; then
	error "--json and --plain are mutually exclusive"
	exit 1
fi

if $output_json && [[ "${COMMAND}" != "list" && "${COMMAND}" != "backup" ]]; then
	error "--json is only valid for 'list' and 'backup'"
	exit 1
fi

if $output_plain && [[ "${COMMAND}" != "list" ]]; then
	error "--plain is only valid for 'list'"
	exit 1
fi

if ($follow || [[ -n "$tail_count" ]]) && [[ "${COMMAND}" != "logs" ]]; then
	error "--follow and --tail are only valid for 'logs'"
	exit 1
fi

if ($unified || $images_only) && [[ "${COMMAND}" != "diff" ]]; then
	error "--unified and --images-only are only valid for 'diff'"
	exit 1
fi

if $unified && $images_only; then
	error "--unified has no effect with --images-only (file diff is skipped); use one or the other"
	exit 1
fi

case "${COMMAND}" in
	list) list ;;
create-network) create_network ;;
start) start "${service_args[@]}" ;;
stop) stop "${service_args[@]}" ;;
restart) restart "${service_args[@]}" ;;
pull) pull "${service_args[@]}" ;;
logs) logs "${service_args[@]}" ;;
ps) ps "${service_args[@]}" ;;
exec) exec "${service_args[@]}" ;;
backup) backup "${service_args[@]}" ;;
restore) restore "${service_args[@]}" ;;
diff) diff_cmd "${service_args[@]}" ;;
enable) enable "${service_args[@]}" ;;
disable) disable "${service_args[@]}" ;;
update) update ;;
completions) completions "${service_args[@]}" ;;
version | --version | -v) echo "$VERSION" ;;
help | --help | -h) help ;;
*)
	error "Unknown command: ${COMMAND}"
	help
	;;
esac
