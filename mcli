#!/usr/bin/env bash
# mcli — manage custom services with Docker Compose
# https://github.com/milvasic/mcli

set -euo pipefail

VERSION="0.20.0"

# ── Help ──────────────────────────────────────────────────────────────────────
help() {
	colorize >&2 <<'EOF'
A single-file CLI for managing custom services with Docker Compose.

Usage: mcli <command> [service1 [service2 ...]] [--dry-run] [--all]

Commands:
  list                      # List discovered services (disabled services are marked)
                            #   --json: JSON array output; --plain: one name per line
  create-network            # Ensure the 'services' Docker bridge network exists
  start [services..]        # Start all or specified services (skips disabled); polls containers for up to 15s after up -d to catch crash-loops (see --no-health, --health-timeout)
  stop [services..]         # Stop all or specified services (skips disabled)
  restart [services..]      # Restart all or specified services (skips disabled)
  pull [services..]         # Pull latest images for all or specified services (skips disabled)
  backup <service>          # Stop service, back up to .bkp/<service>/<date>[.<counter>].tar.gz, restart service
                            #   Archive includes image.txt with container image digests
  backup <service> --live   # Back up without stopping (live backup)
  backup --all              # Back up every enabled service in turn
  backup size               # Show disk space used by backups
  backup prune              # Prune old backups by count and/or age; see --keep, --older-than, --service
  restore <service>         # Restore service from a backup archive in .bkp/<service>/; interactive picker when multiple backups exist
  restore <service> --backup <name>     # Restore from exact archive filename (tar.gz) under .bkp/<service>/; also searches pre-restore/
  restore <service> --backup latest     # Restore from the newest regular backup (by mtime)
  restore <service> --backup pre-restore-latest  # Restore from the newest pre-restore archive (by mtime)
  restore --all             # Restore every enabled service in turn; interactive picker per service
  diff <service>            # Compare current service directory against a backup archive; interactive picker when multiple backups exist
  diff <service> --backup <name|latest>  # Non-interactive backup selection
  disable <services..>      # Disable one or more services (excluded from start/stop/restart/pull)
  enable <services..>       # Re-enable one or more previously disabled services
  update                    # Update mcli to the latest version
  update --check            # Check if an update is available without installing; exit 0=up to date, 1=available, 2=local newer, 3=fetch failed
  logs <service> [--follow|-f] [--tail N]   # Tail logs for a service (docker compose logs)
  ps [services..]                            # Show container status for all or specified services (docker compose ps)
  exec <service> <cmd> [args..]              # Execute a command in a running container (docker compose exec)
  completions bash|zsh      # Output shell completion script (source to activate)
  version, --version, -v    # Print version
  help, --help, -h          # Show this message

Options:
  --dry-run                 # Print commands that would be executed, but do not run them
                            #   (applicable to: create-network, start, stop, restart, pull, backup, restore, update, logs, ps, exec)
                            #   (can appear anywhere after the command)
  --no-health               # Skip post-start container health polling
                            #   (applicable to: start, restart)
                            #   (can appear anywhere after the command)
  --health-timeout N        # Seconds to poll for running state after docker compose up -d (default: 15)
                            #   (applicable to: start, restart)
                            #   (can appear anywhere after the command)
  --all                     # Include disabled services in start/stop/restart/pull/logs/ps/exec; loop over all services (including disabled) for backup/restore
                            #   (applicable to: start, stop, restart, pull, backup, restore, logs, ps, exec)
                            #   (can appear anywhere after the command)
  --live                    # Skip stop/start around backup; back up while the service is running
                            #   (applicable to: backup)
                            #   (can appear anywhere after the command)
  --keep N                  # After backup, prune oldest archives until at most N remain per service
                            #   (applicable to: backup, backup prune)
                            #   Pre-restore archives under pre-restore/ are not counted or pruned
  --older-than DUR          # Prune archives older than DUR (e.g. 30d, 12h, 2w; units: s, m, h, d, w)
                            #   (applicable to: backup prune)
  --service NAME            # Restrict backup prune to a single service
                            #   (applicable to: backup prune)
  --backup <name|latest|pre-restore-latest>
                            # Select a backup non-interactively; 'latest' picks the newest regular archive by mtime,
                            #   'pre-restore-latest' picks the newest pre-restore archive by mtime,
                            #   any other value is treated as an exact filename (with or without .tar.gz)
                            #   (applicable to: restore)
  --yes                     # Auto-accept the pre-restore snapshot prompt without interaction
                            #   (applicable to: restore; mutually exclusive with --no-pre-restore)
  --no-pre-restore          # Skip the pre-restore snapshot entirely (do not prompt, do not create)
                            #   (applicable to: restore; mutually exclusive with --yes)
  --unified                 # Show full unified diff output instead of brief summary
                            #   (applicable to: diff)
  --images-only             # Show only image-version drift, skip file diff
                            #   (applicable to: diff)
  --sudo                    # Always run tar (and find for restore) with sudo
                            #   (applicable to: backup, restore, diff)
  --no-sudo                 # Never run tar (and find for restore) with sudo
                            #   (applicable to: backup, restore, diff; mutually exclusive with --sudo)
  --json                    # Output in JSON format (machine-readable)
                             #   (applicable to: list, backup size)
  --plain                   # Output in plain text (one item per line, no decoration)
                             #   (applicable to: list)
  --follow, -f              # Follow log output (like tail -f)
                             #   (applicable to: logs)
  --tail N                  # Show N lines from the end of the logs (default: all)
                             #   (applicable to: logs)
  --check                   # Check if an update is available without installing
                             #   (applicable to: update)

Service discovery:
  - Each service is an immediate subfolder containing a docker compose file (docker-compose.yml, docker-compose.yaml, compose.yml, or compose.yaml)
  - Folders ignored by git (via `git check-ignore`, full gitignore semantics), folders with a .git directory, and symlinks are skipped

Configuration:
  Disabled services are stored in ${XDG_CONFIG_HOME:-~/.config}/mcli/disabled
  Service start/stop order is read from .mcli/order (one service name per line; # comments allowed)
    Services listed in the file start in that order; unlisted services follow in discovery order
    stop always runs in reverse start order

Shell completions:
  # Bash (add to ~/.bashrc):
  source <(mcli completions bash)
  # Zsh (add to ~/.zshrc):
  source <(mcli completions zsh)

Usage example:
  mcli start                        # starts all enabled services by default
  mcli stop my-service --dry-run
  mcli disable my-service           # disables 'my-service' for future start/stop/pull commands
  mcli start --all                  # includes disabled services as well
EOF
	exit 1
}

# ── Colors & logging ──────────────────────────────────────────────────────────
if [ -t 1 ]; then
	RED=$'\033[0;31m'
	GREEN=$'\033[0;32m'
	YELLOW=$'\033[0;33m'
	CYAN=$'\033[0;36m'
	BOLD=$'\033[1m'
	RESET=$'\033[0m'
else
	RED=""
	GREEN=""
	YELLOW=""
	CYAN=""
	BOLD=""
	RESET=""
fi

log() { printf "\n${BOLD}=== %s ===${RESET}\n" "$1" >&2; }
dry_run_log() { printf "${YELLOW}[dry-run]${RESET} %s\n" "$1" >&2; }
error() { printf "${RED}ERROR:${RESET} %s\n" "$1" >&2; }
ok() { printf "${GREEN}%s${RESET}\n" "$1" >&2; }

# Escape a string for safe inclusion in JSON output.
json_escape() {
	local s="$1"
	s="${s//\\/\\\\}"
	s="${s//\"/\\\"}"
	s="${s//$'\n'/\\n}"
	s="${s//$'\t'/\\t}"
	s="${s//$'\r'/\\r}"
	s="${s//$'\b'/\\b}"
	s="${s//$'\f'/\\f}"
	printf '%s' "$s"
}

# Render argv as a shell-safe, copy-pasteable command string for dry-run logs.
print_cmd() {
	local out
	out=$(printf '%q ' "$@")
	printf '%s' "${out% }"
}

# ── Help colorizer ───────────────────────────────────────────────────────────
colorize_line() {
	sed \
		-e "s/\\(^\\|[^[:alnum:]_'-]\\)\\(mcli\\)\\([^[:alnum:]_'-]\\|$\\)/\\1${GREEN}\\2${RESET}\\3/g" \
		-e "s/\\(^\\|[^[:alnum:]_'-]\\)\\(list\\|create-network\\|start\\|stop\\|restart\\|pull\\|backup\\|restore\\|diff\\|enable\\|disable\\|update\\|logs\\|ps\\|exec\\|completions\\|version\\|help\\)\\([^[:alnum:]_'-]\\|$\\)/\\1${YELLOW}\\2${RESET}\\3/g" \
		-e "s/--[a-z][a-z-]*/${CYAN}&${RESET}/g" \
		-e "s/\([ ,]\)\(-[a-z]\)/\\1${CYAN}\\2${RESET}/g"
}

colorize() {
	local line pre post
	while IFS= read -r line; do
		if [[ "$line" == *'#'* ]]; then
			pre="${line%%#*}"
			post="${line#*#}"
			pre="$(printf '%s' "$pre" | colorize_line)"
			printf '%s%s#%s%s\n' "$pre" "$GREEN" "$post" "$RESET"
		else
			printf '%s\n' "$line" | colorize_line
		fi
	done
}

# ── Configuration ─────────────────────────────────────────────────────────────
config_file() {
	echo "${XDG_CONFIG_HOME:-$HOME/.config}/mcli/disabled"
}

order_file() {
	echo ".mcli/order"
}

# Canonical path of $PWD. Falls back through readlink → realpath → pwd so
# the disabled-services config keys off a stable identity even when the
# directory is reached via a symlink (e.g. /srv/stack → /data/stack).
canonical_pwd() {
	readlink -f . 2>/dev/null || realpath . 2>/dev/null || pwd
}

# Rewrite legacy entries whose directory resolves to $pwd_canonical via a
# non-canonical path. Idempotent: a no-op when all entries are already
# canonical. Called from the write paths so the config self-heals the
# next time a user runs enable/disable from the affected directory.
migrate_disabled_config() {
	local cf="$1" pwd_canonical="$2"
	[ -f "$cf" ] || return 0
	local rewrote=false line dir base resolved
	local -a out=()
	while IFS= read -r line; do
		if [[ -z "$line" ]]; then
			out+=("$line")
			continue
		fi
		dir="${line%/*}"
		base="${line##*/}"
		if [[ "$dir" != "$pwd_canonical" ]] && [ -d "$dir" ]; then
			resolved="$(readlink -f "$dir" 2>/dev/null || realpath "$dir" 2>/dev/null || echo "$dir")"
			if [[ "$resolved" == "$pwd_canonical" ]]; then
				line="$pwd_canonical/$base"
				rewrote=true
			fi
		fi
		out+=("$line")
	done <"$cf"
	$rewrote || return 0
	declare -A seen=()
	# Write to a sibling temp file and rename, so a crash mid-write cannot
	# truncate $cf and silently re-enable every disabled service.
	local tmp_cf
	tmp_cf=$(mktemp "$(dirname "$cf")/disabled.XXXXXX")
	if ! {
		for line in "${out[@]}"; do
			if [[ -z "$line" ]]; then
				printf '\n'
			elif [[ -z "${seen[$line]:-}" ]]; then
				seen[$line]=1
				printf '%s\n' "$line"
			fi
		done
	} >"$tmp_cf"; then
		rm -f "$tmp_cf"
		return 1
	fi
	mv "$tmp_cf" "$cf"
}

get_disabled_services() {
	local cf
	cf=$(config_file)
	[ -f "$cf" ] || return 0
	local prefix
	prefix="$(canonical_pwd)/"
	while IFS= read -r line; do
		[[ -z "$line" ]] && continue
		if [[ "$line" == "$prefix"* ]]; then
			echo "${line#"$prefix"}"
		fi
	done <"$cf"
}

is_service_disabled() {
	local service="$1"
	local cf
	cf=$(config_file)
	[ -f "$cf" ] || return 1
	grep -qxF "$(canonical_pwd)/$service" "$cf"
}

# ── Service discovery ─────────────────────────────────────────────────────────
get_services() {
	local services=()
	# Use `git check-ignore` for real .gitignore semantics when we're inside a
	# git work tree. Outside a git repo, .gitignore is not honored. `git rev-parse
	# --is-inside-work-tree` exits 0 in bare repos too, so check the printed value.
	local use_git_check=false
	if command -v git >/dev/null 2>&1 && [[ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" == "true" ]]; then
		use_git_check=true
	fi
	local candidates=()
	shopt -s nullglob
	for dir in */; do
		# skip if not a directory
		[ -d "$dir" ] || continue
		# skip symlinks
		[ -L "$dir" ] && continue
		# skip if .git exists in the folder
		[ -d "$dir/.git" ] && continue
		# must have a Compose file (v1 or v2 default filename)
		for name in docker-compose.yml docker-compose.yaml compose.yml compose.yaml; do
			if [ -f "$dir/$name" ]; then
				candidates+=("${dir%/}")
				break
			fi
		done
	done
	shopt -u nullglob
	# Bulk-filter ignored candidates in a single `git check-ignore` process
	# instead of one process per directory.
	local -A ignored=()
	if $use_git_check && [ ${#candidates[@]} -gt 0 ]; then
		local ign
		while IFS= read -r ign; do
			ignored["$ign"]=1
		done < <(printf '%s\n' "${candidates[@]}" | git check-ignore --stdin 2>/dev/null)
	fi
	local c
	for c in "${candidates[@]}"; do
		[[ -n "${ignored[$c]:-}" ]] && continue
		services+=("$c")
	done
	[[ ${#services[@]} -gt 0 ]] && printf '%s\n' "${services[@]}"
}

# Reorder services (one per line on stdin) according to .mcli/order.
# Services named in the file come first in file order; the rest follow in their
# original (discovery) order. Lines starting with # and blank lines are ignored.
apply_order() {
	local order_f
	order_f=$(order_file)

	local input=()
	mapfile -t input
	[ ${#input[@]} -eq 0 ] && return 0

	if [ ! -f "$order_f" ]; then
		printf '%s\n' "${input[@]}"
		return 0
	fi

	local ordered=() line
	while IFS= read -r line; do
		line="${line#"${line%%[![:space:]]*}"}"  # ltrim
		line="${line%"${line##*[![:space:]]}"}"  # rtrim
		[[ -z "$line" || "$line" == '#'* ]] && continue
		ordered+=("$line")
	done < "$order_f"

	if [ ${#ordered[@]} -eq 0 ]; then
		printf '%s\n' "${input[@]}"
		return 0
	fi

	local -A in_input=() emitted=()
	local svc
	for svc in "${input[@]}"; do
		in_input["$svc"]=1
	done

	for svc in "${ordered[@]}"; do
		[[ -n "${in_input[$svc]:-}" ]] || continue
		printf '%s\n' "$svc"
		emitted["$svc"]=1
	done

	for svc in "${input[@]}"; do
		[[ -z "${emitted[$svc]:-}" ]] || continue
		printf '%s\n' "$svc"
	done
}

# Filter services by arguments (if any), excluding disabled services unless --all
filter_services() {
	local cf
	cf=$(config_file)
	[ -f "$cf" ] && migrate_disabled_config "$cf" "$(canonical_pwd)"
	local all_services=()
	mapfile -t all_services < <(get_services)
	local disabled_services=()
	mapfile -t disabled_services < <(get_disabled_services)

	local candidates=()
	if [ $# -eq 0 ]; then
		candidates=("${all_services[@]}")
	else
		local invalid=false
		for arg in "$@"; do
			local matched=false
			for svc in "${all_services[@]}"; do
				if [[ "$svc" == "$arg" ]]; then
					candidates+=("$svc")
					matched=true
				fi
			done
			if ! $matched; then
				error "Unknown service: ${CYAN}${arg}${RESET}"
				invalid=true
			fi
		done
		$invalid && return 1
	fi

	# Remove disabled services unless --all is set; collect result for ordering
	local result=()
	if $include_all || [ ${#disabled_services[@]} -eq 0 ]; then
		result=("${candidates[@]}")
	else
		for svc in "${candidates[@]}"; do
			local is_disabled=false
			for dsvc in "${disabled_services[@]}"; do
				if [[ "$svc" == "$dsvc" ]]; then
					is_disabled=true
					break
				fi
			done
			if $is_disabled; then
				if [ $# -gt 0 ]; then
					error "'${CYAN}${svc}${RESET}' is disabled (use ${CYAN}--all${RESET} to include it)"
				fi
			else
				result+=("$svc")
			fi
		done
	fi

	[ ${#result[@]} -gt 0 ] && printf '%s\n' "${result[@]}" | apply_order
}

# ── List command ──────────────────────────────────────────────────────────────
list() {
	local cf
	cf=$(config_file)
	[ -f "$cf" ] && migrate_disabled_config "$cf" "$(canonical_pwd)"

	local services=()
	local order_f
	order_f=$(order_file)

	if [ -f "$order_f" ]; then
		mapfile -t services < <(get_services | apply_order)
	else
		mapfile -t services < <(get_services)
	fi

	if [[ ${#services[@]} -eq 0 ]]; then
		if $output_json; then
			echo "[]"
		elif $output_plain; then
			:
		else
			log "Discovered services:"
			echo "  (none found)"
		fi
		return 0
	fi

	# Build the ordered list (same ordering as the normal colour output)
	if [ ! -f "$order_f" ]; then
		local enabled=() disabled=()
		for service in "${services[@]}"; do
			if is_service_disabled "$service"; then
				disabled+=("$service")
			else
				enabled+=("$service")
			fi
		done
		local sorted_enabled=() sorted_disabled=()
		[ ${#enabled[@]} -gt 0 ] && mapfile -t sorted_enabled < <(printf '%s\n' "${enabled[@]}" | sort)
		[ ${#disabled[@]} -gt 0 ] && mapfile -t sorted_disabled < <(printf '%s\n' "${disabled[@]}" | sort)
		services=("${sorted_enabled[@]}" "${sorted_disabled[@]}")
	fi

	# --json output
	if $output_json; then
		local first=true
		printf '['
		for service in "${services[@]}"; do
			$first || printf ','
			first=false
			if is_service_disabled "$service"; then
				printf '{"name":"%s","enabled":false}' "$(json_escape "$service")"
			else
				printf '{"name":"%s","enabled":true}' "$(json_escape "$service")"
			fi
		done
		printf ']\n'
		return 0
	fi

	# --plain output
	if $output_plain; then
		for service in "${services[@]}"; do
			echo "$service"
		done
		return 0
	fi

	# Normal colour output
	log "Discovered services:"
	for service in "${services[@]}"; do
		if is_service_disabled "$service"; then
			printf "  ${CYAN}%s${RESET} ${YELLOW}(disabled)${RESET}\n" "$service"
		else
			printf "  ${CYAN}%s${RESET}\n" "$service"
		fi
	done
}

# ── Core commands ───────────────────────────────────────────────────────────────────
create_network() {
	log "Ensuring Docker network 'services' exists"
	if $dry_run; then
		dry_run_log "docker network inspect services || docker network create --driver bridge services"
	elif docker network inspect services >/dev/null 2>&1; then
		log "Network 'services' already exists"
	else
		docker network create --driver bridge services
	fi
}

start() {
	local services=()
	local services_output
	services_output=$(filter_services "$@") || return 1
	[[ -n "$services_output" ]] && mapfile -t services <<<"$services_output"
	local failed=()
	for service in "${services[@]}"; do
		log "Starting ${CYAN}${service}${RESET}"
		local -a cmd=(docker compose --project-directory "$service" up -d)
		if $dry_run; then
			dry_run_log "$(print_cmd "${cmd[@]}")"
			if ! $no_health; then
				dry_run_log "poll: docker compose --project-directory \"$service\" ps --format '{{.State}}' (up to ${health_timeout}s)"
			fi
		else
			if ! "${cmd[@]}"; then
				error "${CYAN}${service}${RESET} start failed"
				failed+=("$service")
			elif ! $no_health; then
				if ! check_service_health "$service"; then
					failed+=("$service")
				fi
			fi
		fi
	done
	if [ ${#failed[@]} -gt 0 ]; then
		error "The following services failed to start: ${CYAN}${failed[*]}${RESET}"
		return 1
	fi
}

stop() {
	local services=()
	local services_output
	services_output=$(filter_services "$@") || return 1
	[[ -n "$services_output" ]] && mapfile -t services <<<"$services_output"
	# Stop in reverse start order so dependents shut down before their dependencies
	local i n=${#services[@]} rev=()
	for ((i=n-1; i>=0; i--)); do rev+=("${services[$i]}"); done
	services=("${rev[@]}")
	local failed=()
	for service in "${services[@]}"; do
		log "Stopping ${CYAN}${service}${RESET}"
		local -a cmd=(docker compose --project-directory "$service" down --remove-orphans)
		if $dry_run; then
			dry_run_log "$(print_cmd "${cmd[@]}")"
		else
			if ! "${cmd[@]}"; then
				error "${CYAN}${service}${RESET} stop failed"
				failed+=("$service")
			fi
		fi
	done
	if [ ${#failed[@]} -gt 0 ]; then
		error "The following services failed to stop: ${CYAN}${failed[*]}${RESET}"
		return 1
	fi
}

restart() {
	stop "$@" || return 1
	start "$@"
}

# ── Disable / Enable commands ──────────────────────────────────────────────────────
enable() {
	if [ $# -eq 0 ]; then
		error "Usage: mcli enable <service1> [service2 ...]"
		return 1
	fi
	local all_services=()
	mapfile -t all_services < <(get_services)
	local invalid=false
	for arg in "$@"; do
		local matched=false
		for svc in "${all_services[@]}"; do
			[[ "$svc" == "$arg" ]] && matched=true && break
		done
		if ! $matched; then
			error "Unknown service: ${CYAN}${arg}${RESET}"
			invalid=true
		fi
	done
	$invalid && return 1

	local cf pwd_canonical
	cf=$(config_file)
	pwd_canonical="$(canonical_pwd)"
	migrate_disabled_config "$cf" "$pwd_canonical"
	for arg in "$@"; do
		local entry
		entry="$pwd_canonical/$arg"
		if [ -f "$cf" ] && grep -qxF "$entry" "$cf"; then
			local tmp
			tmp=$(grep -vxF "$entry" "$cf" || true)
			printf '%s\n' "$tmp" >"$cf"
			# Remove trailing empty lines left by printf on empty content
			if [ ! -s "$cf" ] || [ -z "$(tr -d '[:space:]' <"$cf")" ]; then
				>"$cf"
			fi
			ok "${CYAN}${arg}${RESET} enabled"
		else
			ok "${CYAN}${arg}${RESET} is already enabled"
		fi
	done
}

disable() {
	if [ $# -eq 0 ]; then
		error "Usage: mcli disable <service1> [service2 ...]"
		return 1
	fi
	local all_services=()
	mapfile -t all_services < <(get_services)
	local invalid=false
	for arg in "$@"; do
		local matched=false
		for svc in "${all_services[@]}"; do
			[[ "$svc" == "$arg" ]] && matched=true && break
		done
		if ! $matched; then
			error "Unknown service: ${CYAN}${arg}${RESET}"
			invalid=true
		fi
	done
	$invalid && return 1

	local cf pwd_canonical
	cf=$(config_file)
	pwd_canonical="$(canonical_pwd)"
	mkdir -p "$(dirname "$cf")"
	touch "$cf"
	migrate_disabled_config "$cf" "$pwd_canonical"
	for arg in "$@"; do
		local entry
		entry="$pwd_canonical/$arg"
		if grep -qxF "$entry" "$cf"; then
			ok "${CYAN}${arg}${RESET} is already disabled"
		else
			echo "$entry" >>"$cf"
			ok "${CYAN}${arg}${RESET} disabled"
		fi
	done
}

# ── Logs / Ps / Exec commands ──────────────────────────────────────────────────
logs() {
	if [ $# -eq 0 ]; then
		error "Usage: mcli logs <service> [--follow|-f] [--tail N]"
		return 1
	fi
	local services=()
	local services_output
	services_output=$(filter_services "$@") || return 1
	[[ -n "$services_output" ]] && mapfile -t services <<<"$services_output"
	if [ ${#services[@]} -eq 0 ]; then
		error "No services matched"
		return 1
	fi
	local failed=()
	for service in "${services[@]}"; do
		log "Logs for ${CYAN}${service}${RESET}"
		local -a cmd=(docker compose --project-directory "$service" logs)
		$follow && cmd+=(--follow)
		[[ -n "$tail_count" ]] && cmd+=(--tail "$tail_count")
		if $dry_run; then
			dry_run_log "$(print_cmd "${cmd[@]}")"
		else
			if ! "${cmd[@]}"; then
				error "${CYAN}${service}${RESET} logs failed"
				failed+=("$service")
			fi
		fi
	done
	if [ ${#failed[@]} -gt 0 ]; then
		error "The following services failed: ${CYAN}${failed[*]}${RESET}"
		return 1
	fi
}

ps() {
	local services=()
	local services_output
	services_output=$(filter_services "$@") || return 1
	[[ -n "$services_output" ]] && mapfile -t services <<<"$services_output"
	if [ ${#services[@]} -eq 0 ]; then
		error "No services matched"
		return 1
	fi
	local failed=()
	for service in "${services[@]}"; do
		log "Status for ${CYAN}${service}${RESET}"
		local -a cmd=(docker compose --project-directory "$service" ps)
		if $dry_run; then
			dry_run_log "$(print_cmd "${cmd[@]}")"
		else
			if ! "${cmd[@]}"; then
				error "${CYAN}${service}${RESET} ps failed"
				failed+=("$service")
			fi
		fi
	done
	if [ ${#failed[@]} -gt 0 ]; then
		error "The following services failed: ${CYAN}${failed[*]}${RESET}"
		return 1
	fi
}

exec() {
	if [ $# -lt 2 ]; then
		error "Usage: mcli exec <service> <cmd> [args..]"
		return 1
	fi
	local service="$1"
	shift
	local cmd_args=("$@")
	local services=()
	local services_output
	services_output=$(filter_services "$service") || return 1
	[[ -n "$services_output" ]] && mapfile -t services <<<"$services_output"
	if [ ${#services[@]} -eq 0 ]; then
		error "Service not found or disabled: ${CYAN}${service}${RESET}"
		return 1
	fi
	local -a cmd=(docker compose --project-directory "$service" exec "${cmd_args[@]}")
	if $dry_run; then
		dry_run_log "$(print_cmd "${cmd[@]}")"
	else
		if ! "${cmd[@]}"; then
			error "${CYAN}${service}${RESET} exec failed"
			return 1
		fi
	fi
}

pull() {
	local services=()
	local services_output
	services_output=$(filter_services "$@") || return 1
	[[ -n "$services_output" ]] && mapfile -t services <<<"$services_output"
	local failed=()
	for service in "${services[@]}"; do
		log "Pulling images for ${CYAN}${service}${RESET} (skipping buildable services)"
		local -a cmd=(docker compose --project-directory "$service" pull --ignore-buildable)
		if $dry_run; then
			dry_run_log "$(print_cmd "${cmd[@]}")"
		else
			if ! "${cmd[@]}"; then
				error "${CYAN}${service}${RESET} pull failed"
				failed+=("$service")
			fi
		fi
	done
	if [ ${#failed[@]} -gt 0 ]; then
		error "The following services failed to pull: ${CYAN}${failed[*]}${RESET}"
		return 1
	fi
}

# ── Post-start health check ──────────────────────────────────────────────────
# Polls container states for up to $health_timeout seconds after `up -d`.
# Returns 0 when all containers reach running state.
# Returns 1 on a terminal bad state (restarting, exited, dead) or timeout.
check_service_health() {
	local service="$1"
	local deadline
	deadline=$(( $(date +%s) + health_timeout ))
	local states
	while [ "$(date +%s)" -lt "$deadline" ]; do
		states=$(docker compose --project-directory "$service" ps --format '{{.State}}' 2>/dev/null | sort -u)
		case "$states" in
			running)
				return 0
				;;
			*restarting*|*exited*|*dead*|*paused*)
				error "${CYAN}${service}${RESET} container state: ${states//$'\n'/ }"
				return 1
				;;
		esac
		sleep 1
	done
	states=$(docker compose --project-directory "$service" ps --format '{{.State}}' 2>/dev/null | sort -u)
	[[ "$states" == "running" ]] && return 0
	error "${CYAN}${service}${RESET} did not reach running state within ${health_timeout}s (state: ${states:-unknown})"
	return 1
}

# Returns 0 if name matches a registered service directory, 1 otherwise.
# Distinct from filter_services: does not exclude disabled services.
is_known_service() {
	local name="$1" svc
	while IFS= read -r svc; do
		[[ "$svc" == "$name" ]] && return 0
	done < <(get_services)
	return 1
}

# ── Image capture ────────────────────────────────────────────────────────────
# Writes <image-name>:<tag>@sha256:<digest> lines for each container.
# Falls back to compose file image references if no containers are running.
capture_image_info() {
	local service="$1"
	local lines=()

	local container_ids
	container_ids=$(docker compose --project-directory "$service" ps -q 2>/dev/null) || true

	if [[ -n "$container_ids" ]]; then
		while IFS= read -r cid; do
			[[ -z "$cid" ]] && continue
			local img_ref img_id repo_digest digest
			img_ref=$(docker inspect --format '{{.Config.Image}}' "$cid" 2>/dev/null) || continue
			img_id=$(docker inspect --format '{{.Image}}' "$cid" 2>/dev/null) || continue
			repo_digest=$(docker image inspect --format '{{index .RepoDigests 0}}' "$img_id" 2>/dev/null) || true
			if [[ -n "$repo_digest" ]]; then
				digest="${repo_digest#*@}"
			else
				digest="$img_id"
			fi
			lines+=("${img_ref}@${digest}")
		done <<< "$container_ids"
	fi

	if [[ ${#lines[@]} -eq 0 ]]; then
		local images
		images=$(docker compose --project-directory "$service" config --images 2>/dev/null) || true
		if [[ -n "$images" ]]; then
			while IFS= read -r img; do
				[[ -z "$img" ]] && continue
				lines+=("$img")
			done <<< "$images"
		fi
	fi

	[[ ${#lines[@]} -gt 0 ]] && printf '%s\n' "${lines[@]}"
}

# ── Backup retention helpers ──────────────────────────────────────────────────
# Parse "<N><unit>" into seconds. Units: s, m (minutes), h, d, w.
parse_duration() {
	local s="$1"
	if [[ ! "$s" =~ ^([0-9]+)([smhdw])$ ]]; then
		error "Invalid duration: '${s}' (expected <N><unit> with unit one of s, m, h, d, w; e.g. 30d)"
		return 1
	fi
	local num="${BASH_REMATCH[1]}" unit="${BASH_REMATCH[2]}"
	case "$unit" in
	s) echo "$num" ;;
	m) echo "$((num * 60))" ;;
	h) echo "$((num * 3600))" ;;
	d) echo "$((num * 86400))" ;;
	w) echo "$((num * 604800))" ;;
	esac
}

# List backup archives for a service, oldest first by mtime. Excludes the
# pre-restore/ subdirectory so those archives are tracked separately.
list_service_backups() {
	local svc_dir="$1"
	[ -d "$svc_dir" ] || return 0
	shopt -s nullglob
	local files=("$svc_dir"/*.tar.gz)
	shopt -u nullglob
	[ ${#files[@]} -eq 0 ] && return 0
	stat -c '%Y %n' "${files[@]}" | sort -n | cut -d' ' -f2-
}

# Delete a single backup archive. Respects --dry-run. Falls back to sudo if
# the unprivileged unlink is denied (archives are written under sudo).
delete_backup() {
	local f="$1"
	if $dry_run; then
		dry_run_log "rm -f $(printf %q "$f")"
		return 0
	fi
	if rm -f "$f" 2>/dev/null; then
		ok "Deleted: $f"
		return 0
	fi
	if sudo rm -f "$f"; then
		ok "Deleted: $f"
		return 0
	fi
	error "Failed to delete: $f"
	return 1
}

# Keep the newest $n archives for $svc; delete the rest. Pre-restore/ excluded.
# Returns non-zero if any deletion failed so callers can surface a partial-failure.
apply_keep_retention() {
	local svc="$1" n="$2"
	local svc_dir=".bkp/${svc}"
	local files=()
	mapfile -t files < <(list_service_backups "$svc_dir")
	local total=${#files[@]}
	if [ "$total" -le "$n" ]; then
		return 0
	fi
	local to_delete=$((total - n))
	log "Pruning ${CYAN}${svc}${RESET}: keeping ${n} of ${total} backup(s), removing ${to_delete}"
	local i pruning_failed=false
	for ((i = 0; i < to_delete; i++)); do
		delete_backup "${files[$i]}" || pruning_failed=true
	done
	$pruning_failed && return 1
	return 0
}

# Delete archives for $svc with mtime older than $cutoff (epoch seconds).
# Returns non-zero if any deletion failed so callers can surface a partial-failure.
apply_older_than_retention() {
	local svc="$1" cutoff="$2"
	local svc_dir=".bkp/${svc}"
	[ -d "$svc_dir" ] || return 0
	shopt -s nullglob
	local files=("$svc_dir"/*.tar.gz)
	shopt -u nullglob
	[ ${#files[@]} -eq 0 ] && return 0
	local stale=() f mtime
	for f in "${files[@]}"; do
		mtime=$(stat -c '%Y' "$f" 2>/dev/null) || continue
		if ((mtime < cutoff)); then
			stale+=("$f")
		fi
	done
	[ ${#stale[@]} -eq 0 ] && return 0
	log "Pruning ${CYAN}${svc}${RESET}: ${#stale[@]} backup(s) older than cutoff"
	local s pruning_failed=false
	for s in "${stale[@]}"; do
		delete_backup "$s" || pruning_failed=true
	done
	$pruning_failed && return 1
	return 0
}

# ── Backup command ────────────────────────────────────────────────────────────
backup_size() {
	local bkp_root=".bkp"
	if [ ! -d "$bkp_root" ]; then
		if $output_json; then
			printf '{"per_service":{},"total":"0"}\n'
		else
			ok "No backups found (.bkp does not exist)"
		fi
		return 0
	fi

	local found=false
	local -a names sizes
	local err_file
	err_file=$(mktemp)
	shopt -s nullglob
	for svc_dir in "$bkp_root"/*/; do
		found=true
		local size name
		size=$(du -sh "$svc_dir" 2>>"$err_file" | cut -f1) || true
		name="${svc_dir#"$bkp_root"/}"
		name="${name%/}"
		names+=("$name")
		sizes+=("$size")
	done
	shopt -u nullglob

	if ! $found; then
		rm -f "$err_file"
		if $output_json; then
			printf '{"per_service":{},"total":"0"}\n'
		else
			ok "No backups found"
		fi
		return 0
	fi

	if $output_json; then
		local total
		total=$(du -sh "$bkp_root" 2>>"$err_file" | cut -f1) || true
		printf '{"per_service":{'
		local first=true i
		for i in "${!names[@]}"; do
			$first || printf ','
			first=false
			printf '"%s":"%s"' "$(json_escape "${names[$i]}")" "$(json_escape "${sizes[$i]}")"
		done
		printf '},"total":"%s"}\n' "$(json_escape "$total")"
		rm -f "$err_file"
		return 0
	fi

	log "Backup disk usage"
	local max_width=5
	local i
	for i in "${!names[@]}"; do
		if (( ${#names[$i]} > max_width )); then max_width=${#names[$i]}; fi
	done
	for i in "${!names[@]}"; do
		printf "  ${CYAN}%-*s${RESET}  %s\n" "$max_width" "${names[$i]}" "${sizes[$i]}"
	done
	local total
	total=$(du -sh "$bkp_root" 2>>"$err_file" | cut -f1) || true
	printf "  %s\n" "$(printf '%*s' "$((max_width + 2))" '' | tr ' ' '-')"
	printf "  ${BOLD}%-*s${RESET}  %s\n" "$max_width" "total" "$total"
	if [[ -s "$err_file" ]]; then
		printf "${YELLOW}note:${RESET} some sizes may be under-counted due to permission errors; run with sudo for full coverage\n" >&2
	fi
	rm -f "$err_file"
}

# Returns 0 (true, needs sudo) if any path under $1 is not readable by current user.
# Used as a heuristic: root-owned docker volume mounts typically fail this check.
_dir_needs_sudo() {
	local dir="$1"
	while IFS= read -r f; do
		[ ! -r "$f" ] && return 0
	done < <(find "$dir" 2>/dev/null)
	return 1
}

# Returns 0 if sudo should be prepended based on $use_sudo and directory access.
# use_sudo=auto: detect via _dir_needs_sudo; true/false: honour explicit override.
_should_use_sudo() {
	local dir="$1"
	case "$use_sudo" in
		true)  return 0 ;;
		false) return 1 ;;
		auto)  _dir_needs_sudo "$dir" ;;
		*)     return 0 ;;
	esac
}

backup() {
	if $output_json && ! { [ $# -eq 1 ] && [ "$1" = "size" ] && ! is_known_service "size"; }; then
		error "--json is only valid for 'backup size'"
		return 1
	fi

	if [ $# -eq 1 ] && [ "$1" = "size" ] && ! is_known_service "size"; then
		backup_size
		return 0
	fi
	if [ $# -ge 1 ] && [ "$1" = "prune" ] && ! is_known_service "prune"; then
		shift
		backup_prune "$@"
		return $?
	fi

	if [[ -n "$older_than" || -n "$prune_service" ]]; then
		error "--older-than and --service are only valid for 'backup prune'"
		return 1
	fi

	# Resolve services to back up. --all picks every enabled service;
	# otherwise a single service argument is required.
	local services_to_backup=()
	if $include_all; then
		if [ $# -gt 0 ]; then
			error "Cannot combine --all with service names"
			return 1
		fi
		local services_output
		services_output=$(filter_services) || return 1
		[[ -n "$services_output" ]] && mapfile -t services_to_backup <<<"$services_output"
		if [ ${#services_to_backup[@]} -eq 0 ]; then
			error "No services to back up"
			return 1
		fi
	else
		if [ $# -ne 1 ]; then
			error "Usage: mcli backup <service> [--live] [--keep N]"
			error "       mcli backup --all [--live] [--keep N]"
			error "       mcli backup size"
			error "       mcli backup prune (--keep N | --older-than DUR) [--service NAME] [--dry-run]"
			return 1
		fi
		if ! is_known_service "$1"; then
			error "Unknown service: ${CYAN}${1}${RESET}"
			return 1
		fi
		services_to_backup=("$1")
	fi

	local failed=()
	local prune_failed=()
	local svc
	for svc in "${services_to_backup[@]}"; do
		if ! backup_one "$svc"; then
			failed+=("$svc")
			continue
		fi
		if [[ -n "$keep_count" ]]; then
			if ! apply_keep_retention "$svc" "$keep_count"; then
				prune_failed+=("$svc")
			fi
		fi
	done

	local rc=0
	if [ ${#failed[@]} -gt 0 ]; then
		error "Backup failed for: ${CYAN}${failed[*]}${RESET}"
		rc=1
	fi
	if [ ${#prune_failed[@]} -gt 0 ]; then
		error "Retention pruning had failures for: ${CYAN}${prune_failed[*]}${RESET}"
		rc=1
	fi
	return $rc
}

backup_one() {
	local service="$1"
	local today
	today=$(date +%Y-%m-%d)
	local bkp_dir=".bkp/${service}"
	local base="${bkp_dir}/${today}"
	local dest="${base}.tar.gz"

	# Capture image info before stopping (non-live) or from running containers (live)
	log "Capturing image info for ${CYAN}${service}${RESET}"
	local image_lines=()
	if $dry_run; then
		dry_run_log "docker compose --project-directory \"$service\" ps -q → per-container docker inspect (Config.Image + RepoDigest) → image.txt"
	else
		mapfile -t image_lines < <(capture_image_info "$service")
		if [[ ${#image_lines[@]} -eq 0 ]]; then
			printf "${YELLOW}Warning:${RESET} no image info captured for ${CYAN}${service}${RESET} (image.txt will be empty)\n" >&2
		fi
	fi

	# Stop service before backup unless --live is set
	if ! $live; then
		log "Stopping ${CYAN}${service}${RESET} before backup"
		local -a stop_cmd=(docker compose --project-directory "$service" down --remove-orphans)
		if $dry_run; then
			dry_run_log "$(print_cmd "${stop_cmd[@]}")"
		else
			if ! "${stop_cmd[@]}"; then
				error "Failed to stop ${CYAN}${service}${RESET} before backup"
				return 1
			fi
		fi
	fi

	local max_attempts=100
	if $dry_run; then
		if [ -f "$dest" ]; then
			local counter=1
			while [ -f "${base}.${counter}.tar.gz" ]; do
				((counter++))
				if [ "$counter" -ge "$max_attempts" ]; then
					error "Could not claim a backup slot after ${max_attempts} attempts"
					return 1
				fi
			done
			dest="${base}.${counter}.tar.gz"
		fi
		log "Backing up ${CYAN}${service}${RESET} to ${dest}"
		local _bkp_sudo=""
		_should_use_sudo "$service" && _bkp_sudo="sudo "
		dry_run_log "mkdir -p \"${bkp_dir}\" && ${_bkp_sudo}tar czf \"${dest}\" -C \"${service}\" . -C \"\$(mktemp -d)\" image.txt"
	else
		mkdir -p "$bkp_dir"
		# Install the cleanup trap before claiming the slot so a Ctrl-C between
		# the noclobber claim and the trap install can't orphan a placeholder.
		# Guarded by $claimed/$tmp_dir so the trap is a no-op until each resource
		# actually exists.
		local claimed=""
		local tmp_dir=""
		trap '[[ -n "$claimed" ]] && rm -f "$claimed"; [[ -n "$tmp_dir" ]] && rm -rf "$tmp_dir"' INT TERM EXIT
		# Atomically claim the destination using noclobber; retry with incrementing counter on collision
		local counter=1
		if ! ( set -C; : > "$dest" ) 2>/dev/null; then
			while ! ( set -C; : > "${base}.${counter}.tar.gz" ) 2>/dev/null; do
				((counter++))
				if [ "$counter" -ge "$max_attempts" ]; then
					trap - INT TERM EXIT
					error "Could not claim a backup slot after ${max_attempts} attempts"
					if ! $live; then
						log "Restarting ${CYAN}${service}${RESET} after failed backup"
						docker compose --project-directory "$service" up -d || true
					fi
					return 1
				fi
			done
			dest="${base}.${counter}.tar.gz"
		fi
		claimed="$dest"
		log "Backing up ${CYAN}${service}${RESET} to ${dest}"
		tmp_dir=$(mktemp -d)
		if [[ ${#image_lines[@]} -gt 0 ]]; then
			printf '%s\n' "${image_lines[@]}" > "$tmp_dir/image.txt"
		else
			> "$tmp_dir/image.txt"
		fi
		local -a _bkp_cmd=()
		_should_use_sudo "$service" && _bkp_cmd+=(sudo)
		_bkp_cmd+=(tar czf "${dest}" -C "${service}" . -C "$tmp_dir" image.txt)
		if ! "${_bkp_cmd[@]}"; then
			trap - INT TERM EXIT
			error "Backup of ${CYAN}${service}${RESET} failed"
			rm -f "$dest"
			rm -rf "$tmp_dir"
			if ! $live; then
				log "Restarting ${CYAN}${service}${RESET} after failed backup"
				docker compose --project-directory "$service" up -d || true
			fi
			return 1
		fi
		rm -rf "$tmp_dir"
		tmp_dir=""
		claimed=""
		trap - INT TERM EXIT
		ok "Backup created: ${dest}"
	fi

	# Restart service after backup unless --live is set
	if ! $live; then
		log "Restarting ${CYAN}${service}${RESET} after backup"
		local -a start_cmd=(docker compose --project-directory "$service" up -d)
		if $dry_run; then
			dry_run_log "$(print_cmd "${start_cmd[@]}")"
		else
			if ! "${start_cmd[@]}"; then
				error "Failed to restart ${CYAN}${service}${RESET} after backup"
				return 1
			fi
		fi
	fi
}

# ── Backup prune subcommand ───────────────────────────────────────────────────
backup_prune() {
	if [ $# -gt 0 ]; then
		error "Unexpected argument(s) to 'backup prune': $*"
		error "Usage: mcli backup prune (--keep N | --older-than DUR) [--service NAME] [--dry-run]"
		return 1
	fi
	if [[ -z "$keep_count" && -z "$older_than" ]]; then
		error "Usage: mcli backup prune (--keep N | --older-than DUR) [--service NAME] [--dry-run]"
		return 1
	fi
	if [[ -n "$prune_service" && "$prune_service" == */* ]]; then
		error "--service: service name must not contain path separators (got: ${prune_service})"
		return 1
	fi

	local bkp_root=".bkp"
	if [ ! -d "$bkp_root" ]; then
		ok "No backups found (.bkp does not exist)"
		return 0
	fi

	local services=()
	if [[ -n "$prune_service" ]]; then
		if [ ! -d "${bkp_root}/${prune_service}" ]; then
			error "No backups found for ${CYAN}${prune_service}${RESET} in ${bkp_root}/"
			return 1
		fi
		services=("$prune_service")
	else
		shopt -s nullglob
		local d name
		for d in "${bkp_root}"/*/; do
			name="${d#"$bkp_root"/}"
			name="${name%/}"
			services+=("$name")
		done
		shopt -u nullglob
	fi

	if [ ${#services[@]} -eq 0 ]; then
		ok "No backups found"
		return 0
	fi

	local cutoff=""
	if [[ -n "$older_than" ]]; then
		local secs
		secs=$(parse_duration "$older_than") || return 1
		cutoff=$(($(date +%s) - secs))
	fi

	local svc
	local failed=()
	for svc in "${services[@]}"; do
		local svc_failed=false
		if [[ -n "$keep_count" ]]; then
			apply_keep_retention "$svc" "$keep_count" || svc_failed=true
		fi
		if [[ -n "$cutoff" ]]; then
			apply_older_than_retention "$svc" "$cutoff" || svc_failed=true
		fi
		$svc_failed && failed+=("$svc")
	done

	if [ ${#failed[@]} -gt 0 ]; then
		error "Prune had failures for: ${CYAN}${failed[*]}${RESET}"
		return 1
	fi
}

# ── Restore command ───────────────────────────────────────────────────────────
restore() {
	if $include_all; then
		if [ $# -gt 0 ]; then
			error "Cannot combine --all with service names"
			return 1
		fi
		if [[ -n "$backup_name" && "$backup_name" != "latest" && "$backup_name" != "pre-restore-latest" ]]; then
			printf "${YELLOW}warning:${RESET} --backup '%s' with --all: each service looks up this filename in its own .bkp/<service>/ directory; services that lack it will error and be skipped.\n" "$backup_name" >&2
		fi
		local services_output
		services_output=$(filter_services) || return 1
		local services=()
		[[ -n "$services_output" ]] && mapfile -t services <<<"$services_output"
		if [ ${#services[@]} -eq 0 ]; then
			error "No services to restore"
			return 1
		fi
		local failed=()
		for svc in "${services[@]}"; do
			if ! restore_one "$svc"; then
				failed+=("$svc")
			fi
		done
		if [ ${#failed[@]} -gt 0 ]; then
			error "Restore failed for: ${CYAN}${failed[*]}${RESET}"
			return 1
		fi
		return 0
	fi

	if [ $# -ne 1 ]; then
		error "Usage: mcli restore <service> [--backup <name|latest|pre-restore-latest>] [--yes | --no-pre-restore]"
		error "       mcli restore --all"
		return 1
	fi
	local service="$1"
	if ! is_known_service "$service"; then
		error "Unknown service: ${CYAN}${service}${RESET}"
		return 1
	fi
	restore_one "$service"
}

restore_one() {
	local service="$1"

	local bkp_dir=".bkp/${service}"

	# Collect available backups: regular first, then pre-restore (tagged), so the
	# picker visually separates the two and never renders identically-named
	# archives on the same line.
	local backups=()
	local labels=()
	shopt -s nullglob
	for f in "${bkp_dir}"/*.tar.gz; do
		backups+=("$f")
		labels+=("$(basename "$f")")
	done
	for f in "${bkp_dir}"/pre-restore/*.tar.gz; do
		backups+=("$f")
		labels+=("[pre-restore] $(basename "$f")")
	done
	shopt -u nullglob

	if [ ${#backups[@]} -eq 0 ]; then
		error "No backups found for ${CYAN}${service}${RESET} in ${bkp_dir}/"
		return 1
	fi

	local chosen
	local chosen_label
	if [[ -n "$backup_name" ]]; then
		case "$backup_name" in
		latest)
			shopt -s nullglob
			local regular_files=("${bkp_dir}"/*.tar.gz)
			shopt -u nullglob
			if [ ${#regular_files[@]} -eq 0 ]; then
				error "No regular backups found for ${CYAN}${service}${RESET} in ${bkp_dir}/"
				return 1
			fi
			chosen=$(stat -c '%Y %n' "${regular_files[@]}" | sort -rn | head -1 | cut -d' ' -f2-)
			chosen_label="$(basename "$chosen")"
			;;
		pre-restore-latest)
			shopt -s nullglob
			local pre_files=("${bkp_dir}"/pre-restore/*.tar.gz)
			shopt -u nullglob
			if [ ${#pre_files[@]} -eq 0 ]; then
				error "No pre-restore backups found for ${CYAN}${service}${RESET} in ${bkp_dir}/pre-restore/"
				return 1
			fi
			chosen=$(stat -c '%Y %n' "${pre_files[@]}" | sort -rn | head -1 | cut -d' ' -f2-)
			chosen_label="[pre-restore] $(basename "$chosen")"
			;;
		*)
			# Exact filename: add .tar.gz suffix if not present, then search both dirs.
			# Reject path separators to prevent directory traversal via sudo tar.
			if [[ "$backup_name" == */* ]]; then
				error "--backup must be a plain filename, not a path (got: '${backup_name}')"
				return 1
			fi
			local lookup="$backup_name"
			[[ "$lookup" != *.tar.gz ]] && lookup="${lookup}.tar.gz"
			local candidate_regular="${bkp_dir}/${lookup}"
			local candidate_pre="${bkp_dir}/pre-restore/${lookup}"
			local found_regular=false found_pre=false
			[ -f "$candidate_regular" ] && found_regular=true
			[ -f "$candidate_pre" ] && found_pre=true
			if $found_regular && $found_pre; then
				error "Ambiguous --backup '${backup_name}': found in both ${bkp_dir}/ and ${bkp_dir}/pre-restore/. Rename one of the conflicting archives."
				return 1
			elif $found_regular; then
				chosen="$candidate_regular"
				chosen_label="$(basename "$chosen")"
			elif $found_pre; then
				chosen="$candidate_pre"
				chosen_label="[pre-restore] $(basename "$chosen")"
			else
				error "--backup '${backup_name}' not found under ${bkp_dir}/ or ${bkp_dir}/pre-restore/"
				log "Available backups for ${CYAN}${service}${RESET}:"
				local i=1
				for label in "${labels[@]}"; do
					printf "  %d) %s\n" "$i" "$label" >&2
					((i++))
				done
				return 1
			fi
			;;
		esac
		log "Restoring ${CYAN}${service}${RESET} from ${chosen_label}"
	elif [ ${#backups[@]} -eq 1 ]; then
		chosen="${backups[0]}"
		chosen_label="${labels[0]}"
		log "Restoring ${CYAN}${service}${RESET} from ${chosen_label}"
	elif $dry_run; then
		log "Available backups for ${CYAN}${service}${RESET}:"
		local i=1
		for label in "${labels[@]}"; do
			printf "  %d) %s\n" "$i" "$label" >&2
			((i++))
		done
		dry_run_log "Would prompt: Select backup [1-${#backups[@]}]"
		chosen="${backups[0]}"
		chosen_label="${labels[0]}"
		log "Restoring ${CYAN}${service}${RESET} from ${chosen_label} (dry-run: using first)"
	else
		log "Available backups for ${CYAN}${service}${RESET}:"
		local i=1
		for label in "${labels[@]}"; do
			printf "  %d) %s\n" "$i" "$label" >&2
			((i++))
		done
		local choice
		while true; do
			printf "Select backup [1-%d]: " "${#backups[@]}" >&2
			read -r choice
			if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#backups[@]}" ]; then
				break
			fi
			error "Invalid selection. Enter a number between 1 and ${#backups[@]}."
		done
		chosen="${backups[$((choice - 1))]}"
		chosen_label="${labels[$((choice - 1))]}"
		log "Restoring ${CYAN}${service}${RESET} from ${chosen_label}"
	fi

	# Stop service first (ensures a clean snapshot if user requests pre-restore backup)
	log "Stopping ${CYAN}${service}${RESET} before restore"
	local -a stop_cmd=(docker compose --project-directory "$service" down --remove-orphans)
	if $dry_run; then
		dry_run_log "$(print_cmd "${stop_cmd[@]}")"
	else
		if ! "${stop_cmd[@]}"; then
			error "Failed to stop ${CYAN}${service}${RESET} before restore"
			return 1
		fi
	fi

	# Pre-restore backup prompt (after stop, so the archive captures a clean state)
	local _pre_snap_sudo=""
	_should_use_sudo "$service" && _pre_snap_sudo="sudo "
	if $dry_run; then
		if $no_pre_restore; then
			dry_run_log "Skipping pre-restore snapshot (--no-pre-restore)"
		elif $auto_yes; then
			dry_run_log "Auto-accepting pre-restore snapshot (--yes)"
			dry_run_log "${_pre_snap_sudo}tar czf \"${bkp_dir}/pre-restore/<date>.tar.gz\" -C \"${service}\" ."
		else
			dry_run_log "Prompt: 'Back up current version before restoring? [y/N]'"
			dry_run_log "${_pre_snap_sudo}tar czf \"${bkp_dir}/pre-restore/<date>.tar.gz\" -C \"${service}\" ."
		fi
	elif $no_pre_restore; then
		: # skip silently
	else
		local pre_restore_ans
		if $auto_yes; then
			pre_restore_ans="y"
		else
			printf "Back up current version before restoring? [y/N] " >&2
			read -r pre_restore_ans
		fi
		if [[ "$pre_restore_ans" =~ ^[Yy]$ ]]; then
			local today pre_restore_dir pre_restore_dest
			today=$(date +%Y-%m-%d)
			pre_restore_dir="${bkp_dir}/pre-restore"
			pre_restore_dest="${pre_restore_dir}/${today}.tar.gz"
			mkdir -p "$pre_restore_dir"
			if [ -f "$pre_restore_dest" ]; then
				local counter=1
				while [ -f "${pre_restore_dir}/${today}.${counter}.tar.gz" ]; do
					((counter++))
				done
				pre_restore_dest="${pre_restore_dir}/${today}.${counter}.tar.gz"
			fi
			log "Creating pre-restore backup of ${CYAN}${service}${RESET}"
			local -a _pre_snap_cmd=()
			_should_use_sudo "$service" && _pre_snap_cmd+=(sudo)
			_pre_snap_cmd+=(tar czf "$pre_restore_dest" -C "$service" .)
			if ! "${_pre_snap_cmd[@]}"; then
				error "Failed to create pre-restore backup"
				log "Restarting ${CYAN}${service}${RESET} after failed pre-restore backup"
				docker compose --project-directory "$service" up -d || true
				return 1
			fi
			ok "Pre-restore backup: ${pre_restore_dest}"
		fi
	fi

	# Clean service dir so restore matches the archive exactly (files added after
	# the backup would otherwise survive, since tar only overwrites overlapping
	# paths). Note: this also wipes bind-mounted paths nested under $service.
	log "Cleaning ${service}/ before extraction"
	local -a clean_cmd=()
	_should_use_sudo "$service" && clean_cmd+=(sudo)
	clean_cmd+=(find "$service" -mindepth 1 -delete)
	if $dry_run; then
		dry_run_log "$(print_cmd "${clean_cmd[@]}")"
	else
		if ! "${clean_cmd[@]}"; then
			error "Failed to clean ${CYAN}${service}${RESET} before restore"
			log "Attempting to restart ${CYAN}${service}${RESET} after failed cleanup"
			docker compose --project-directory "$service" up -d || true
			return 1
		fi
	fi

	# Extract archive into service directory
	log "Extracting $(basename "$chosen") into ${service}/"
	local -a restore_cmd=()
	_should_use_sudo "$service" && restore_cmd+=(sudo)
	restore_cmd+=(tar xzf "$chosen" -C "$service")
	if $dry_run; then
		dry_run_log "$(print_cmd "${restore_cmd[@]}")"
	else
		if ! "${restore_cmd[@]}"; then
			error "Restore of ${CYAN}${service}${RESET} failed"
			log "Attempting to restart ${CYAN}${service}${RESET} after failed restore"
			docker compose --project-directory "$service" up -d || true
			return 1
		fi
		ok "Restored: $(basename "$chosen") → ${service}/"
	fi

	# Start service
	log "Starting ${CYAN}${service}${RESET} after restore"
	local -a start_cmd=(docker compose --project-directory "$service" up -d)
	if $dry_run; then
		dry_run_log "$(print_cmd "${start_cmd[@]}")"
	else
		if ! "${start_cmd[@]}"; then
			error "Failed to start ${CYAN}${service}${RESET} after restore"
			return 1
		fi
	fi
}

# ── Diff command ─────────────────────────────────────────────────────────────
diff_cmd() {
	if [ $# -ne 1 ]; then
		error "Usage: mcli diff <service> [--backup <name|latest>] [--unified] [--images-only]"
		return 1
	fi
	local service="$1"
	if ! is_known_service "$service"; then
		error "Unknown service: ${CYAN}${service}${RESET}"
		return 1
	fi
	diff_one "$service"
}

diff_one() {
	local service="$1"
	local bkp_dir=".bkp/${service}"

	# Collect available backups: regular first, then pre-restore (same as restore_one)
	local backups=() labels=()
	shopt -s nullglob
	for f in "${bkp_dir}"/*.tar.gz; do
		backups+=("$f")
		labels+=("$(basename "$f")")
	done
	for f in "${bkp_dir}"/pre-restore/*.tar.gz; do
		backups+=("$f")
		labels+=("[pre-restore] $(basename "$f")")
	done
	shopt -u nullglob

	if [ ${#backups[@]} -eq 0 ]; then
		error "No backups found for ${CYAN}${service}${RESET} in ${bkp_dir}/"
		return 1
	fi

	# Archive selection (mirrors restore_one logic)
	local chosen chosen_label
	if [[ -n "$backup_name" ]]; then
		case "$backup_name" in
		latest)
			shopt -s nullglob
			local regular_files=("${bkp_dir}"/*.tar.gz)
			shopt -u nullglob
			if [ ${#regular_files[@]} -eq 0 ]; then
				error "No regular backups found for ${CYAN}${service}${RESET} in ${bkp_dir}/"
				return 1
			fi
			chosen=$(stat -c '%Y %n' "${regular_files[@]}" | sort -rn | head -1 | cut -d' ' -f2-)
			chosen_label="$(basename "$chosen")"
			;;
		pre-restore-latest)
			shopt -s nullglob
			local pre_files=("${bkp_dir}"/pre-restore/*.tar.gz)
			shopt -u nullglob
			if [ ${#pre_files[@]} -eq 0 ]; then
				error "No pre-restore backups found for ${CYAN}${service}${RESET} in ${bkp_dir}/pre-restore/"
				return 1
			fi
			chosen=$(stat -c '%Y %n' "${pre_files[@]}" | sort -rn | head -1 | cut -d' ' -f2-)
			chosen_label="[pre-restore] $(basename "$chosen")"
			;;
		*)
			if [[ "$backup_name" == */* ]]; then
				error "--backup must be a plain filename, not a path (got: '${backup_name}')"
				return 1
			fi
			local lookup="$backup_name"
			[[ "$lookup" != *.tar.gz ]] && lookup="${lookup}.tar.gz"
			local candidate_regular="${bkp_dir}/${lookup}"
			local candidate_pre="${bkp_dir}/pre-restore/${lookup}"
			local found_regular=false found_pre=false
			[ -f "$candidate_regular" ] && found_regular=true
			[ -f "$candidate_pre" ] && found_pre=true
			if $found_regular && $found_pre; then
				error "Ambiguous --backup '${backup_name}': found in both ${bkp_dir}/ and ${bkp_dir}/pre-restore/. Rename one of the conflicting archives."
				return 1
			elif $found_regular; then
				chosen="$candidate_regular"
				chosen_label="$(basename "$chosen")"
			elif $found_pre; then
				chosen="$candidate_pre"
				chosen_label="[pre-restore] $(basename "$chosen")"
			else
				error "--backup '${backup_name}' not found under ${bkp_dir}/ or ${bkp_dir}/pre-restore/"
				log "Available backups for ${CYAN}${service}${RESET}:"
				local i=1
				for label in "${labels[@]}"; do
					printf "  %d) %s\n" "$i" "$label" >&2
					((i++))
				done
				return 1
			fi
			;;
		esac
		log "Comparing ${CYAN}${service}${RESET} against ${chosen_label}"
	elif [ ${#backups[@]} -eq 1 ]; then
		chosen="${backups[0]}"
		chosen_label="${labels[0]}"
		log "Comparing ${CYAN}${service}${RESET} against ${chosen_label}"
	elif $dry_run; then
		log "Available backups for ${CYAN}${service}${RESET}:"
		local i=1
		for label in "${labels[@]}"; do
			printf "  %d) %s\n" "$i" "$label" >&2
			((i++))
		done
		dry_run_log "Would prompt: Select backup [1-${#backups[@]}]"
		chosen="${backups[0]}"
		chosen_label="${labels[0]}"
		log "Comparing ${CYAN}${service}${RESET} against ${chosen_label} (dry-run: using first)"
	else
		log "Available backups for ${CYAN}${service}${RESET}:"
		local i=1
		for label in "${labels[@]}"; do
			printf "  %d) %s\n" "$i" "$label" >&2
			((i++))
		done
		local choice
		while true; do
			printf "Select backup [1-%d]: " "${#backups[@]}" >&2
			read -r choice
			if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#backups[@]}" ]; then
				break
			fi
			error "Invalid selection. Enter a number between 1 and ${#backups[@]}."
		done
		chosen="${backups[$((choice - 1))]}"
		chosen_label="${labels[$((choice - 1))]}"
		log "Comparing ${CYAN}${service}${RESET} against ${chosen_label}"
	fi

	if $dry_run; then
		local _diff_sudo=""
		_should_use_sudo "$service" && _diff_sudo="sudo "
		dry_run_log "${_diff_sudo}tar xzf $(printf %q "$chosen") -C <tmp>/<archive-name>"
		if ! $images_only; then
			if $unified; then
				dry_run_log "diff -r --unified=3 --exclude=image.txt $(printf %q "$service") <tmp>/<archive-name>/"
			else
				dry_run_log "diff -r --brief --exclude=image.txt $(printf %q "$service") <tmp>/<archive-name>/"
			fi
		fi
		dry_run_log "compare image.txt from archive vs currently running containers"
		return 0
	fi

	# Extract archive to a temp directory
	local tmp_dir
	tmp_dir=$(mktemp -d)
	trap 'rm -rf "$tmp_dir"' INT TERM EXIT
	local archive_subdir
	archive_subdir="$(basename "$chosen" .tar.gz)"
	local extract_dir="$tmp_dir/$archive_subdir"
	mkdir "$extract_dir"

	local -a extract_cmd=()
	_should_use_sudo "$service" && extract_cmd+=(sudo)
	extract_cmd+=(tar xzf "$chosen" -C "$extract_dir")
	if ! "${extract_cmd[@]}"; then
		error "Failed to extract ${chosen}"
		trap - INT TERM EXIT
		rm -rf "$tmp_dir"
		return 1
	fi

	local any_diff=false

	# Image drift: compare archive image.txt against currently running containers
	log "Image versions for ${CYAN}${service}${RESET} (backup vs current)"
	if [ -f "$extract_dir/image.txt" ]; then
		local archive_images current_images
		archive_images=$(sort "$extract_dir/image.txt")
		current_images=$(capture_image_info "$service" | sort)
		if [[ "$archive_images" == "$current_images" ]]; then
			ok "Images: no drift"
		else
			local image_diff_rc=0
			diff \
				--label "backup:${chosen_label}" \
				--label "current:running" \
				<(printf '%s\n' "$archive_images") \
				<(printf '%s\n' "$current_images") || image_diff_rc=$?
			if [ $image_diff_rc -eq 1 ]; then
				any_diff=true
			elif [ $image_diff_rc -ne 0 ]; then
				error "diff encountered an error during image comparison (exit code: $image_diff_rc)"
				trap - INT TERM EXIT
				rm -rf "$tmp_dir"
				return 1
			fi
		fi
	else
		printf "${YELLOW}note:${RESET} archive has no image.txt; skipping image drift\n" >&2
	fi

	# File diff
	if ! $images_only; then
		log "File diff for ${CYAN}${service}${RESET} (current vs backup)"
		local -a diff_args=(diff -r --exclude=image.txt)
		if $unified; then
			diff_args+=(--unified=3)
		else
			diff_args+=(--brief)
		fi
		diff_args+=("$service" "$extract_dir")
		local diff_rc=0
		"${diff_args[@]}" || diff_rc=$?
		if [ $diff_rc -eq 0 ]; then
			ok "Files: no differences"
		elif [ $diff_rc -eq 1 ]; then
			any_diff=true
		else
			error "diff encountered an error (exit code: $diff_rc)"
			trap - INT TERM EXIT
			rm -rf "$tmp_dir"
			return 1
		fi
	fi

	! $any_diff && ! $images_only && ok "No differences found"

	trap - INT TERM EXIT
	rm -rf "$tmp_dir"
}

# ── Completions command ───────────────────────────────────────────────────────
completions() {
	local shell="${1:-}"
	case "$shell" in
	bash)
		cat <<'BASH_COMPLETION'
# mcli bash completion
# Source this file or add to ~/.bashrc: source <(mcli completions bash)

__mcli_services() {
	mcli list --plain 2>/dev/null
}

_mcli() {
	COMPREPLY=()
	local cur="${COMP_WORDS[COMP_CWORD]}"
	local cword="$COMP_CWORD"
	local command="${COMP_WORDS[1]:-}"
	local all_commands="list create-network start stop restart pull logs ps exec backup restore diff disable enable update completions version help"

	if [[ "$cword" -eq 1 ]]; then
		COMPREPLY=($(compgen -W "$all_commands" -- "$cur"))
		return
	fi

	case "$command" in
	list)
		COMPREPLY=($(compgen -W "--json --plain" -- "$cur"))
		;;
	start | restart)
		COMPREPLY=($(compgen -W "$(__mcli_services) --dry-run --all --no-health --health-timeout" -- "$cur"))
		;;
	stop | pull)
		COMPREPLY=($(compgen -W "$(__mcli_services) --dry-run --all" -- "$cur"))
		;;
	logs)
		COMPREPLY=($(compgen -W "$(__mcli_services) --dry-run --all --follow --tail" -- "$cur"))
		;;
	ps)
		COMPREPLY=($(compgen -W "$(__mcli_services) --dry-run --all" -- "$cur"))
		;;
	exec)
		COMPREPLY=($(compgen -W "$(__mcli_services) --dry-run --all" -- "$cur"))
		;;
	disable | enable)
		COMPREPLY=($(compgen -W "$(__mcli_services) --dry-run" -- "$cur"))
		;;
	restore)
		COMPREPLY=($(compgen -W "$(__mcli_services) --dry-run --all --backup --yes --no-pre-restore --sudo --no-sudo" -- "$cur"))
		;;
	backup)
		COMPREPLY=($(compgen -W "size prune $(__mcli_services) --dry-run --json --live --all --keep --older-than --service --sudo --no-sudo" -- "$cur"))
		;;
	diff)
		COMPREPLY=($(compgen -W "$(__mcli_services) --dry-run --backup --unified --images-only --sudo --no-sudo" -- "$cur"))
		;;
	completions)
		COMPREPLY=($(compgen -W "bash zsh" -- "$cur"))
		;;
	create-network | update)
		COMPREPLY=($(compgen -W "--dry-run" -- "$cur"))
		;;
	esac
}

complete -F _mcli mcli
BASH_COMPLETION
		;;
	zsh)
		cat <<'ZSH_COMPLETION'
#compdef mcli
# mcli zsh completion
# Source this file or add to ~/.zshrc: source <(mcli completions zsh)

_mcli() {
	local cur="${words[CURRENT]}"
	local cmd="${words[2]:-}"
	local -a services

	if [[ $CURRENT -eq 2 ]]; then
		local -a commands
		commands=(
			'list:List discovered services'
			'create-network:Ensure the shared services Docker bridge network exists'
			'start:Start all or specified services'
			'stop:Stop all or specified services'
			'restart:Restart all or specified services'
			'pull:Pull latest images for services'
			'logs:Tail logs for a service'
			'ps:Show container status for services'
			'exec:Execute a command in a running container'
			'backup:Back up a service'
			'restore:Restore a service from a backup archive'
			'diff:Compare current service directory against a backup'
			'disable:Disable one or more services'
			'enable:Re-enable one or more services'
			'update:Update mcli to the latest version'
			'completions:Output shell completions script'
			'version:Print version'
			'help:Show help message'
		)
		_describe 'command' commands
		return
	fi

	services=(${(f)"$(mcli list --plain 2>/dev/null)"})

	case "$cmd" in
	start | restart)
		compadd -a services
		compadd -- --dry-run --all --no-health --health-timeout
		;;
	stop | pull)
		compadd -a services
		compadd -- --dry-run --all
		;;
	logs)
		compadd -a services
		compadd -- --dry-run --all --follow --tail
		;;
	ps | exec)
		compadd -a services
		compadd -- --dry-run --all
		;;
	disable | enable)
		compadd -a services
		compadd -- --dry-run
		;;
	restore)
		compadd -a services
		compadd -- --dry-run --all --backup --yes --no-pre-restore --sudo --no-sudo
		;;
	list)
		compadd -- --json --plain
		;;
	diff)
		compadd -a services
		compadd -- --dry-run --backup --unified --images-only --sudo --no-sudo
		;;
	backup)
		compadd -- size prune
		compadd -a services
		compadd -- --dry-run --json --live --all --keep --older-than --service --sudo --no-sudo
		;;
	completions)
		compadd -- bash zsh
		;;
	create-network | update)
		compadd -- --dry-run
		;;
	esac
}

_mcli "$@"
ZSH_COMPLETION
		;;
	*)
		error "Usage: mcli completions <shell>"
		printf "Supported shells: bash, zsh\n" >&2
		exit 1
		;;
	esac
}

